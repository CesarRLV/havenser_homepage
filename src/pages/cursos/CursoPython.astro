---


import Layout from '../../layouts/Layout.astro';
 import '../../styles/global.css';
 import Boton from '../../components/Boton.astro';
 import LogrosCapacitacion from '../../components/Capacitaciones/LogrosCapacitacion.astro';
import EtiquetaInfo from '../../components/Capacitaciones/EtiquetaInfo.astro';
import ContactoCapacitacion from '../../components/Capacitaciones/ContactoCapacitacion.astro';

const logros = [
  "Reportes automáticos: lo que hoy toma horas en Excel, se ejecuta en minutos y sin errores de captura.",
  "Conciliaciones confiables: cruces de almacén, piso y proveedores con datos limpios y trazables.",
  "Decisiones más rápidas: información estandarizada y lista para la gerencia, todos los días.",
  "Talento potenciado: ingenieros con perfil de análisis de datos, listos para escalar a SQL y analítica avanzada."
];

const como_trabajamos = [
    "100% práctico: ejercicios guiados con casos reales en cada sesión.",
    "En vivo + grabado: quien falte a una sesión la recupera con el material grabado.",
    "Acompañamiento: retroalimentación directa del instructor en el proyecto final."
];

const condiciones_especiales = [
    "Facturación: se emite CFDI conforme a los datos fiscales proporcionados.",
    "Pago: liquidación total previa al inicio · precios en pesos mexicanos (MXN).",
    "Grabaciones: disponibles 1 semana después de cada sesión."
];

const SITE_INFO={
    TELEFONO_CURSOS: "+52 1 55 1234 5678",
    EMAIL_CURSOS: "consultoria@havenser.com",
    NOMBRE: "Havenser",
    URL: "www.havenser.com"
}

---

<Layout title="Curso de Python">
    <div class="infographic-container flex flex-col">
        
        <!-- ENCABEZADO -->
        <div class="bg-slate-900 text-white pt-20 pb-16 px-2 relative">
            <div class="absolute top-0 right-0 w-96 h-96 bg-blue-600 opacity-20 rounded-full blur-3xl -mr-20 -mt-20"></div>
            <div class="flex justify-between items-center mb-12 relative z-10">
                <div>
                    <h2 class="text-3xl font-bold tracking-widest text-slate-400 uppercase">Capacitación Corporativa</h2>
                    <h3 class="text-2xl font-light text-slate-300 mt-2 tracking-widest">100% EN LÍNEA</h3>
                </div>
                <div class="flex items-center gap-4">
                    <svg class="w-16 h-16 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    <h1 class="text-5xl font-black tracking-tight"><a href="/">HAVENSER</a></h1>
                </div>
            </div>
            <div class="relative z-10 mt-8">
                <h1 class="text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400 leading-tight">
                    CURSO DE PYTHON
                </h1>
                <h2 class="text-5xl font-bold mt-4 text-white">Para Ingenieros Automotrices</h2>
                <p class="text-3xl font-light mt-8 text-slate-300 border-l-8 border-orange-500 pl-6">
                    Del Excel manual a la automatización de datos con Python.
                </p>
            </div>
            <div class="relative pt-8 pb-0 mb-0">
                <Boton texto="Descargar Información del curso"/>
            </div>
        </div>

        <!-- BANDA DE DETALLES -->
        <div class="bg-orange-500 text-white grid grid-cols-3 divide-x divide-orange-400 py-10 shadow-lg relative z-20">
            <div class="text-center px-6">
                <p class="text-2xl font-bold text-orange-200 uppercase tracking-wider mb-2">Inversión</p>
                <p class="text-4xl font-black">$ 40,000 + IVA</p>
            </div>
            <div class="text-center px-6">
                <p class="text-2xl font-bold text-orange-200 uppercase tracking-wider mb-2">Duración</p>
                <p class="text-4xl font-black">6 Semanas - 36 horas</p>
            </div>
            <div class="text-center px-6">
                <p class="text-2xl font-bold text-orange-200 uppercase tracking-wider mb-2">Modalidad</p>
                <p class="text-4xl font-black">En línea (En vivo + Grabado)</p>
            </div>
        </div>

        <!-- PRESENTACIÓN -->
        <div class="px-20 py-16 bg-white">
            <h3 class="text-4xl font-black text-slate-800 mb-8 flex items-center gap-4">
                <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                Innovando en cada paso...
            </h3>
            <p class="text-3xl text-slate-600 leading-relaxed font-light">
                <strong class="font-bold">¿Cuántas horas pierde su equipo cada semana copiando, cruzando y conciliando datos en Excel?</strong> En 6 semanas, sus ingenieros convierten ese trabajo manual en procesos 
                automáticos con Python — sin depender de sistemas ni de terceros.
            </p>
        </div>

        <LogrosCapacitacion listado={logros} titulo="LO QUE SU EQUIPO LOGRARÁ" />
        <EtiquetaInfo titulo="ENTREGABLE FINAL — VALOR DESDE EL DÍA UNO">
            <p class="text-3xl text-slate-600 leading-relaxed font-light">
                Cada participante entrega un cálculo de faltantes / conciliación automatizada / resumen de costos o reporte de ventas (según sea el proyecto final elegido). Una herramienta real para la empresa que su operación usa desde la semana 6.
            </p>
        </EtiquetaInfo>
        <ContactoCapacitacion />
        <!-- ROADMAP 6 SEMANAS -->
        <div class="flex-grow bg-slate-50 px-20 py-16">
            <div class="text-center mb-16">
                <h3 class="text-5xl font-black text-slate-900 uppercase tracking-wide">Roadmap Técnico</h3>
                <div class="w-32 h-2 bg-blue-600 mx-auto mt-6 rounded-full"></div>
            </div>

            <div class="relative">
                <!-- Línea central conectora -->
                <div class="absolute left-12 top-10 bottom-10 w-2 bg-slate-200 rounded-full"></div>

                <!-- Modulo 1 -->
                <div class="flex gap-12 mb-16 relative">
                    <div class="w-24 h-24 bg-blue-600 rounded-full flex items-center justify-center text-white text-4xl font-black z-10 shadow-lg border-8 border-slate-50 flex-shrink-0">
                        1
                    </div>
                    <div class="bg-white p-10 rounded-2xl shadow-xl border border-slate-100 flex-grow">
                        <h4 class="text-4xl font-bold text-slate-800 mb-4">Lógica y pensamiento algorítmico</h4>
                        <p class="text-3xl text-slate-600">
                            Descompone problemas del piso de producción en pasos automatizables
                        </p>
                    </div>
                </div>

                <!-- Modulo 2 -->
                <div class="flex gap-12 mb-16 relative">
                    <div class="w-24 h-24 bg-blue-600 rounded-full flex items-center justify-center text-white text-4xl font-black z-10 shadow-lg border-8 border-slate-50 flex-shrink-0">
                        2
                    </div>
                    <div class="bg-white p-10 rounded-2xl shadow-xl border border-slate-100 flex-grow">
                        <h4 class="text-4xl font-bold text-slate-800 mb-4">Fundamentos de Python (Jupyter / Colab)</h4>
                        <p class="text-3xl text-slate-600">
                            Escribe sus primeros programas: variables, condiciones, listas y diccionarios.
                        </p>
                    </div>
                </div>

                <!-- Modulo 3 -->
                <div class="flex gap-12 mb-16 relative">
                    <div class="w-24 h-24 bg-orange-500 rounded-full flex items-center justify-center text-white text-4xl font-black z-10 shadow-lg border-8 border-slate-50 flex-shrink-0">
                        3
                    </div>
                    <div class="bg-white p-10 rounded-2xl shadow-xl border border-slate-100 flex-grow">
                        <h4 class="text-4xl font-bold text-slate-800 mb-4">Automatización de Tareas Repetitivas</h4>
                        <p class="text-3xl text-slate-600">
                            Convierte procesos manuales en funciones reutilizables — "macros en código".
                        </p>
                    </div>
                </div>

                <!-- Modulo 4 -->
                <div class="flex gap-12 mb-16 relative">
                    <div class="w-24 h-24 bg-emerald-500 rounded-full flex items-center justify-center text-white text-4xl font-black z-10 shadow-lg border-8 border-slate-50 flex-shrink-0">
                        4
                    </div>
                    <div class="bg-white p-10 rounded-2xl shadow-xl border border-slate-100 flex-grow">
                        <h4 class="text-4xl font-bold text-slate-800 mb-4">Datos con NumPy</h4>
                        <p class="text-3xl text-slate-600">
                            Importa y limpia archivos .csv y .xlsx a gran escala, sin abrir Excel.
                        </p>
                    </div>
                </div>

                <!-- Modulo 5 -->
                <div class="flex gap-12 mb-16 relative">
                    <div class="w-24 h-24 bg-emerald-600 rounded-full flex items-center justify-center text-white text-4xl font-black z-10 shadow-lg border-8 border-slate-50 flex-shrink-0">
                        5
                    </div>
                    <div class="bg-white p-10 rounded-2xl shadow-xl border border-slate-100 flex-grow">
                        <h4 class="text-4xl font-bold text-slate-800 mb-4">Pandas I — el "nuevo Excel"</h4>
                        <p class="text-3xl text-slate-600">
                            Filtra, agrupa y depura miles de registros en segundos.
                        </p>
                    </div>
                </div>

                <!-- Modulo 6 -->
                <div class="flex gap-12 relative">
                    <div class="w-24 h-24 bg-slate-800 rounded-full flex items-center justify-center text-white text-4xl font-black z-10 shadow-lg border-8 border-slate-50 flex-shrink-0">
                        6
                    </div>
                    <div class="bg-slate-800 p-10 rounded-2xl shadow-xl border border-slate-700 flex-grow text-white relative overflow-hidden">
                        <div class="absolute right-0 top-0 opacity-10">
                            <svg class="w-64 h-64 -mt-10 -mr-10" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                        </div>
                        <h4 class="text-4xl font-bold text-white mb-4 relative z-10">Pandas II — cruces y tablas dinámicas</h4>
                        <p class="text-3xl text-slate-300 relative z-10">Cruza bases de datos y exporta reportes automáticos listos para gerencia.</p>
                    </div>
                </div>
            </div>
        </div>

        <LogrosCapacitacion listado={como_trabajamos} titulo="CÓMO TRABAJAMOS" />
        <LogrosCapacitacion listado={condiciones_especiales} titulo="CONDICIONES ESENCIALES" />

        <!-- FOOTER / CONTACTO -->
        <div class="bg-slate-900 text-white p-16 flex flex-col items-center text-center">
            <h4 class="text-4xl font-bold mb-10 text-emerald-400">¿Agendamos una llamada de 15 minutos para definir la fecha de arranque de su grupo?</h4>
            
            <div class="grid grid-cols-3 gap-8 w-full max-w-4xl border-t border-slate-700 pt-10">
                <div class="flex flex-col items-center">
                    <svg class="w-10 h-10 mb-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    <p class="text-xl">Tel. {SITE_INFO.TELEFONO_CURSOS}</p>
                </div>
                <div class="flex flex-col items-center">
                    <svg class="w-10 h-10 mb-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <p class="text-xl">{SITE_INFO.EMAIL_CURSOS}</p>
                </div>
                <div class="flex flex-col items-center">
                    <svg class="w-10 h-10 mb-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
                    <p class="text-xl">www.havenser.com</p>
                </div>
            </div>
            <p class="text-lg text-slate-500 mt-12">
                © Havenser Consulting. Todos los derechos reservados. Sujeto a cambios sin previo aviso por causas ajenas a su voluntad.
            </p>
        </div>

    </div>
<Layout/>
  <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            display: flex;
            justify-content: center;
            padding: 2rem;
        }
        /* Contenedor exacto de 1080x2400 */
        .infographic-container {
            width: 1480px;
            height: 2400px;
            background-color: #ffffff;
            position: relative;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25)
            overflow: hidden;
            flex-shrink: 0;
            transform-origin: top center;
        }
        /* Pequeño script de CSS para escalar en pantallas pequeñas solo para previsualización */
        @media (max-width: 1200px) {
            body { padding: 0; align-items: flex-start;}
            .infographic-container {
                transform: scale(0.5);
                margin-bottom: -1200px; /* Compensa el escalado */
            }
        }
        @media (max-width: 600px) {
            .infographic-container {
                transform: scale(0.3);
                margin-bottom: -1680px;
            }
        }
    </style>