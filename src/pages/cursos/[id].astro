---
// src/pages/cursos/[id].astro
//
// Genera una página estática real por cada curso del catálogo (Astro
// `getStaticPaths`). Para agregar/quitar un curso de aquí, edita
// src/data/cursos.ts — esta página no necesita cambios.
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import PlantillaCurso from "../../components/cursos/PlantillaCurso.astro";
import { CURSOS } from "../../data/cursos";

export function getStaticPaths() {
  return CURSOS.map((curso) => ({
    params: { id: String(curso.id) },
    props: { curso },
  }));
}

const { curso } = Astro.props;

const cursoLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: curso.titulo,
  description: curso.descripcion,
  inLanguage: "es-MX",
  educationalLevel: curso.nivel,
  provider: { "@id": "https://havenser.com/#organizacion" },
};
---

<Layout title={`${curso.titulo} | Cursos Havenser`} description={curso.descripcion.slice(0, 158)} jsonLd={cursoLd}>
  <NavBar />
  <PlantillaCurso curso={curso} />
</Layout>
