---
// Plantilla de las páginas /soluciones/*: hero, beneficios, [herramienta
// interactiva vía <slot />], proceso, preguntas frecuentes y CTA final.
// Publica JSON-LD de Service, FAQPage y BreadcrumbList.
//
// Uso:
//   <PlantillaSolucion solucion={getSolucion('chatbot-whatsapp')} oscuro ctaTexto="Agenda una demo">
//     ...secciones propias de la página...
//   </PlantillaSolucion>
import Layout from "../../layouts/Layout.astro";
import NavBar from "../NavBar.astro";
import { SITIO, linkWhatsApp } from "../../data/sitio";
import type { Solucion } from "../../data/soluciones";

interface Props {
  solucion: Solucion;
  /** Hero en zona oscura de marca. */
  oscuro?: boolean;
  ctaTexto?: string;
  ctaHref?: string;
  extraJsonLd?: Record<string, unknown>[];
}

const { solucion: s, oscuro = false, ctaTexto = "Cotiza tu solución", ctaHref = "/contactanos", extraJsonLd = [] } = Astro.props;
const url = `${SITIO.url}/soluciones/${s.slug}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: s.nombreCorto,
    description: s.metaDescripcion,
    serviceType: s.nombreCorto,
    url,
    provider: { "@id": `${SITIO.url}/#organizacion` },
    areaServed: { "@type": "Country", name: "México" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: s.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: SITIO.url },
      { "@type": "ListItem", position: 2, name: s.nombreCorto, item: url },
    ],
  },
  ...extraJsonLd,
];

const externo = ctaHref.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {};
const mensajeWhatsApp = `Hola Havenser, me interesa ${s.nombreCorto.toLowerCase()}. ¿Podemos platicar?`;
---

<Layout title={s.metaTitulo} description={s.metaDescripcion} jsonLd={jsonLd}>
  <NavBar />
  <main id="contenido">
    <!-- Hero -->
    <section class:list={["sol-hero", oscuro ? "zona-oscura" : "sol-hero-claro"]}>
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <nav aria-label="Ruta de navegación" class="migas">
          <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">{s.nombreCorto}</span>
        </nav>
        <p class="eyebrow">{s.eyebrow}</p>
        <h1 class="sol-titulo">{s.h1}</h1>
        <p class="sol-sub">{s.sub}</p>
        <div class="flex flex-wrap gap-3">
          <a href={ctaHref} class="btn-oro" {...externo}>{ctaTexto}</a>
          <a href={linkWhatsApp(mensajeWhatsApp)} target="_blank" rel="noopener noreferrer" class="btn-borde">
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>
      <div class="sol-hero-deco" aria-hidden="true" data-parallax="-30"></div>
    </section>

    <!-- Beneficios -->
    <section class="py-20 md:py-24 bg-[var(--bg-light)]">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <ul class:list={["grid gap-6 list-none p-0 m-0", s.beneficios.length === 4 ? "md:grid-cols-2 lg:grid-cols-4" : "md:grid-cols-3"]} data-stagger>
          {s.beneficios.map((b) => (
            <li class="beneficio">
              <span class="beneficio-marca" aria-hidden="true"></span>
              <h2 class="text-xl font-bold text-[var(--text-heading)] mb-2">{b.titulo}</h2>
              <p class="text-[var(--text-body)] m-0">{b.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <slot />

    <!-- Proceso -->
    <section class="py-20 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="max-w-2xl mb-12" data-animar="fade-up">
          <p class="eyebrow">Cómo empezamos</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-heading)]">Un proceso claro, sin sorpresas</h2>
        </div>
        <ol class:list={["grid gap-8 list-none p-0 m-0", s.proceso.length === 4 ? "md:grid-cols-2 lg:grid-cols-4" : "md:grid-cols-3"]} data-stagger>
          {s.proceso.map((p, i) => (
            <li class="paso">
              <span class="paso-num">{i + 1}</span>
              <h3 class="text-lg font-bold text-[var(--text-heading)] mb-1">{p.titulo}</h3>
              <p class="text-[var(--text-body)] m-0">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Preguntas frecuentes (también en JSON-LD FAQPage) -->
    <section class="py-20 md:py-24 bg-[var(--bg-light)]" aria-labelledby="faq-titulo">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-titulo" class="text-3xl md:text-4xl font-bold text-[var(--text-heading)] mb-8">Lo que más nos preguntan</h2>
        <div class="faq-lista">
          {s.faqs.map((f) => (
            <details class="faq">
              <summary>
                <h3>{f.q}</h3>
                <span class="faq-icono" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="zona-oscura py-20 md:py-24">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center" data-animar="zoom">
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">¿Lo platicamos?</h2>
        <p class="text-lg text-[#b9c0cc] mb-8">Cuéntenos su caso y le respondemos con una propuesta concreta.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={ctaHref} class="btn-oro" {...externo}>{ctaTexto}</a>
          <a href={linkWhatsApp(mensajeWhatsApp)} target="_blank" rel="noopener noreferrer" class="btn-borde text-[var(--text-light)]">
            WhatsApp {SITIO.telefonoVisible}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .sol-hero {
    position: relative;
    overflow: hidden;
    padding: 9rem 0 5rem;
  }
  .sol-hero-claro { background: linear-gradient(180deg, #e6e6f0 0%, var(--bg-light) 100%); color: var(--text-heading); }
  .sol-hero .btn-borde { color: inherit; }
  .zona-oscura.sol-hero .btn-borde { color: var(--text-light); border-color: rgba(230, 230, 240, 0.4); }

  .sol-titulo {
    max-width: 18ch;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .zona-oscura .sol-titulo { color: #fff; }
  .sol-sub {
    max-width: 62ch;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    margin-bottom: 2rem;
    color: var(--text-body);
    text-wrap: pretty;
  }
  .zona-oscura .sol-sub { color: #b9c0cc; }

  .migas { font-size: 0.875rem; margin-bottom: 1.5rem; color: #6e7b90; }
  .migas a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .migas a:hover { color: var(--gold); }

  /* Malla de puntos decorativa (se mueve con parallax). */
  .sol-hero-deco {
    position: absolute;
    right: -6vw;
    top: 10%;
    width: min(48vw, 560px);
    aspect-ratio: 1;
    background-image: radial-gradient(circle, rgba(201, 161, 38, 0.45) 1.5px, transparent 1.6px);
    background-size: 22px 22px;
    mask-image: radial-gradient(circle, #000 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .sol-hero > div:first-child { position: relative; z-index: 1; }

  .beneficio {
    padding: 1.75rem;
    border-radius: 1rem;
    background: var(--surface-white);
    border: 1px solid var(--border-soft);
  }
  .beneficio-marca {
    display: block;
    width: 36px;
    height: 3px;
    margin-bottom: 1.25rem;
    border-radius: 2px;
    background: var(--gold);
  }

  .paso-num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--text-heading);
    color: var(--gold);
    font-weight: 700;
  }

  .faq-lista { border-top: 1px solid var(--border-soft); }
  .faq { border-bottom: 1px solid var(--border-soft); }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq h3 { margin: 0; font-size: 1.1rem; color: var(--text-heading); }
  .faq p { margin: 0 0 1.25rem; color: var(--text-body); max-width: 65ch; }
  .faq-icono {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .faq-icono::before,
  .faq-icono::after {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 2px;
    background: var(--gold);
    transition: transform 0.25s ease;
  }
  .faq-icono::after { transform: rotate(90deg); }
  .faq[open] .faq-icono::after { transform: rotate(0deg); }
</style>
