---
// src/components/Navbar.astro
---

<nav x-data="{ open: false }" class="bg-[#E6E6F0] shadow-lg sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6  flex justify-between items-center">
    
    <a href="/" class="flex items-center gap-3">
      <img src="/LOGO1.png" alt="Logo" class="h-18 w-auto" />
      <span class="text-3xl font-extrabold text-[#121D2F] tracking-tighter uppercase" style="font-family: 'Arial Black', sans-serif;">HAVENSER</span>
    </a>

    <button @click="open = !open" class="md:hidden text-white focus:outline-none">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>

    <ul 
      :class="open ? 'flex' : 'hidden md:flex'" 
      class="absolute md:relative top-full left-0 w-full md:w-auto bg-[#E6E6F0] md:bg-transparent flex-col md:flex-row gap-6 p-6 md:p-0 items-center border-t border-gray-700 md:border-none"
    >
      <li><a href="#nosotros" @click="open = false" class="text-gray-800! hover:text-orange-500 font-medium transition-colors text-lg" style="font-family: Calibri, sans-serif;">¿Quiénes somos?</a></li>
      <li><a href="#servicios" @click="open = false" class="text-gray-800! hover:text-orange-500 font-medium transition-colors text-lg" style="font-family: Calibri, sans-serif;">Nuestros Servicios</a></li>
      <li><a href="#eventos" @click="open = false" class="text-gray-800! hover:text-orange-500 font-medium transition-colors text-lg" style="font-family: Calibri, sans-serif;">Galería</a></li>
      <li>
        <a href="#contacto" @click="open = false" class="bg-orange-500 text-white px-6 py-2 rounded-lg hover:bg-orange-600 transition duration-300 font-bold">
          Contacto
        </a>
      </li>
    </ul>
  </div>
</nav>