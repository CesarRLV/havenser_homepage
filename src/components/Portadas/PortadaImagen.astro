---
const {alto, urlImagen, titulo, parrafo, direction="right"} = Astro.props;

let justify="";
let dir = "";
if(direction==="right"){
    dir=direction;
    justify="end";
} else if(direction==="left"){
    dir=direction;
    justify="baseline";
}

---

<div
    class=`relative w-full h-[${alto}] md:h-screen bg-cover bg-center items-baseline flex items-${justify} justify-${justify} p-8`
    style=`background-image: url(${urlImagen}); height: ${alto};`
>
    <!-- Capa oscura opcional para que el texto se lea mejor -->
    <div class="absolute inset-0 bg-black/30"></div>

    <!-- Texto alineado a la derecha inferior -->
    <div class=`relative z-10 text-${dir} text-white`>
        <h1 class="text-3xl md:text-5xl font-bold">{titulo}</h1>
        <p class="text-lg md:text-xl mt-2">
            {parrafo}
        </p>
    </div>
</div>
