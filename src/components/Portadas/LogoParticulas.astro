---
/**
 * LogoParticulas.astro
 * ------------------------------------------------------------------
 * Nube de partículas (estilo estrellas) que se dispersan y luego se
 * organizan hasta formar el monograma H+A de la empresa.
 *
 * DISEÑO
 * - Colores tomados directamente del logo real y de la paleta
 *   institucional: navy #10192d (trazos de la H) y azul apagado
 *   #3e4b61 (trazo de la A), sobre fondo transparente para heredar
 *   el fondo claro del sitio.
 * - Una sola secuencia de formación al entrar en el viewport
 *   (no hay parpadeos ni loops constantes por defecto), con una
 *   pequeña respiración/idle una vez formado. Puede activarse un
 *   ciclo de disolver/reformar opcional con la prop `loop`.
 * - Respeta `prefers-reduced-motion`: si el usuario lo activa, el
 *   logo aparece ya formado, sin animación.
 *
 * ADAPTABILIDAD AL CONTENEDOR
 * - El componente no impone tamaño propio: ocupa 100% del ancho y
 *   alto de su contenedor (el padre define el tamaño real, p. ej.
 *   con un div de 400px de alto, o con aspect-ratio).
 * - Todos los estilos están en un <style> con scope automático de
 *   Astro y una clase específica (.logo-particulas), por lo que no
 *   hay selectores globales que puedan afectar a hermanos o al padre.
 * - El <canvas> tiene pointer-events: none, así que nunca bloquea
 *   clics de elementos superpuestos (botones, texto, etc.).
 * - El script se ejecuta por instancia (uid único), así que puedes
 *   usar el componente varias veces en la misma página sin conflictos.
 *
 * USO BÁSICO
 *   <div style="width: 100%; height: 420px;">
 *     <LogoParticulas />
 *   </div>
 *
 * PROPS (todas opcionales)
 *   class            clases extra para el contenedor (Tailwind, etc.)
 *   starColor        color de las partículas antes de formar el logo (hex). Default: "#c9a126"
 *   duration         duración en ms de la animación de formación. Default: 2400
 *   particleDensity  "baja" | "media" | "alta" — cantidad de partículas. Default: "media"
 *   loop             si true, tras mantenerse formado se disuelve y se vuelve a formar. Default: false
 *   holdMs           ms que el logo permanece formado antes de disolverse (solo si loop=true). Default: 5000
 *   ariaLabel        texto accesible para lectores de pantalla.
 */

interface Props {
  class?: string;
  starColor?: string;
  duration?: number;
  particleDensity?: "baja" | "media" | "alta";
  loop?: boolean;
  holdMs?: number;
  ariaLabel?: string;
}

const {
  class: className = "",
  starColor = "#c9a126",
  duration = 2400,
  particleDensity = "media",
  loop = false,
  holdMs = 5000,
  ariaLabel = "Logo de la empresa formándose a partir de una nube de partículas",
} = Astro.props;

// Identificador único por instancia: permite usar el componente
// varias veces en la misma página sin que los scripts choquen entre sí.
const uid = `lp-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={["logo-particulas", className]} id={uid} role="img" aria-label={ariaLabel}>
  <canvas class="logo-particulas__canvas"></canvas>
</div>

<style>
  /* Todo queda bajo .logo-particulas: no hay selectores de elemento
     "sueltos" (como `canvas { ... }`) que puedan filtrarse a otros
     nodos del documento. Astro además scopea este bloque de forma
     automática con un atributo data-astro-cid-*. */
  .logo-particulas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 120px;
    overflow: hidden;
    line-height: 0;
    contain: layout paint;
  }

  .logo-particulas__canvas {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script define:vars={{ uid, starColor, duration, particleDensity, loop, holdMs }}>
  /* Imagen del logo (silueta a dos tonos, recortada y con fondo
     transparente) embebida como data URI. Se usa únicamente en el
     navegador para "leer" qué píxeles pertenecen al logo y así
     calcular los puntos de destino de cada partícula: no depende de
     ningún archivo externo, por lo que el componente es 100% autónomo. */
  const LOGO_DATA_URI = "data:image/png;base64,";

  (function initLogoParticulas() {
    const root = document.getElementById(uid);
    if (!root || root.dataset.lpInit === "1") return;
    root.dataset.lpInit = "1";

    const canvas = root.querySelector(".logo-particulas__canvas");
    const ctx = canvas.getContext("2d");

    const mqReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let reducedMotion = mqReducedMotion.matches;

    const DENSITY_STEP = { baja: 5, media: 3, alta: 2 }[particleDensity] || 3;
    const DISPERSAL_MS = duration * 0.7;
    const DISPERSED_HOLD_MS = 900;

    function hexToRgb(hex) {
      const m = hex.replace("#", "").match(/.{1,2}/g) || ["c9", "a1", "26"];
      return [parseInt(m[0], 16), parseInt(m[1], 16), parseInt(m[2], 16)];
    }
    const starRGB = hexToRgb(starColor);

    function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
    function lerp(a, b, t) { return a + (b - a) * t; }
    function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
    function easeInCubic(t) { return t * t * t; }

    let cw = 0, ch = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let particles = [];
    let decorStars = [];
    let imgW = 1, imgH = 1;
    let points = [];
    let ready = false;
    let visible = false;
    let rafId = null;

    // 0 = formando, 1 = formado (idle), 2 = disolviendo, 3 = disuelto (idle disperso)
    let cycleState = 0;
    let cycleStart = null;

    function mapPointToCanvas(nx, ny) {
      // Ajuste tipo "contain": la silueta conserva su proporción y
      // queda centrada, dejando un margen de aire alrededor.
      const marginFactor = 0.86;
      const boxW = cw * marginFactor;
      const boxH = ch * marginFactor;
      const scale = Math.min(boxW / imgW, boxH / imgH);
      const drawW = imgW * scale;
      const drawH = imgH * scale;
      const offX = (cw - drawW) / 2;
      const offY = (ch - drawH) / 2;
      return [offX + nx * drawW, offY + ny * drawH];
    }

    function randomScatterPos() {
      // Las partículas nacen (o se dispersan) más allá del propio
      // lienzo, como si vinieran de un campo de estrellas, y "vuelan"
      // hacia adentro para formar el logo.
      const cx = cw / 2, cy = ch / 2;
      const maxR = Math.max(cw, ch) * 0.75;
      const ang = Math.random() * Math.PI * 2;
      const r = maxR * (0.35 + Math.random() * 0.9);
      return [cx + Math.cos(ang) * r, cy + Math.sin(ang) * r];
    }

    function construirParticulas() {
      particles = points.map((p) => {
        const [tx, ty] = mapPointToCanvas(p.nx, p.ny);
        const [sx, sy] = randomScatterPos();
        return {
          nx: p.nx, ny: p.ny,
          colorTo: [p.r, p.g, p.b],
          posA: [sx, sy], posB: [tx, ty],
          colorA: starRGB, colorB: [p.r, p.g, p.b],
          delay: Math.random() * duration * 0.45,
          sizeFinal: 1.1 + Math.random() * 1.1,
          sizeStart: 0.6 + Math.random() * 0.5,
          phase: Math.random() * Math.PI * 2,
        };
      });

      decorStars = Array.from({ length: 46 }, () => ({
        x: Math.random() * cw,
        y: Math.random() * ch,
        r: 0.5 + Math.random() * 1,
        baseAlpha: 0.15 + Math.random() * 0.35,
        speed: 0.4 + Math.random() * 0.8,
        phase: Math.random() * Math.PI * 2,
      }));
    }

    function actualizarObjetivos() {
      // Se llama al redimensionar: recalcula dónde debe caer cada
      // partícula del logo sin reiniciar la animación en curso.
      for (const p of particles) {
        const [tx, ty] = mapPointToCanvas(p.nx, p.ny);
        p.tx = tx; p.ty = ty;
        if (cycleState === 0) p.posB = [tx, ty];
        if (cycleState === 1) { p.posA = [tx, ty]; p.posB = [tx, ty]; }
      }
    }

    function cargarLogo() {
      const img = new Image();
      img.onload = () => {
        imgW = img.naturalWidth;
        imgH = img.naturalHeight;
        const off = document.createElement("canvas");
        off.width = imgW; off.height = imgH;
        const octx = off.getContext("2d");
        octx.drawImage(img, 0, 0);
        const data = octx.getImageData(0, 0, imgW, imgH).data;
        const pts = [];
        for (let y = 0; y < imgH; y += DENSITY_STEP) {
          for (let x = 0; x < imgW; x += DENSITY_STEP) {
            const i = (y * imgW + x) * 4;
            const a = data[i + 3];
            if (a > 90) {
              pts.push({ nx: x / imgW, ny: y / imgH, r: data[i], g: data[i + 1], b: data[i + 2] });
            }
          }
        }
        points = pts;
        dimensionarCanvas();
        construirParticulas();
        actualizarObjetivos();
        ready = true;
        // Se fija el instante real de arranque justo cuando las partículas
        // ya existen, para que la animación nunca "salte" directo al
        // estado formado por haber corrido algún frame vacío antes de esto.
        cycleStart = performance.now();
        if (visible) arrancar();
      };
      img.src = LOGO_DATA_URI;
    }

    function dimensionarCanvas() {
      cw = root.clientWidth || 1;
      ch = root.clientHeight || 1;
      canvas.width = Math.round(cw * dpr);
      canvas.height = Math.round(ch * dpr);
      canvas.style.width = cw + "px";
      canvas.style.height = ch + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    let pausedAt = null;

    function arrancar() {
      if (rafId !== null) return;
      const now = performance.now();
      if (cycleStart === null) {
        cycleStart = now;
      } else if (pausedAt !== null) {
        // Desplaza la línea de tiempo del ciclo por lo que duró la
        // pausa, así al volver a ser visible no "salta" hacia atrás.
        cycleStart += now - pausedAt;
        pausedAt = null;
      }
      rafId = requestAnimationFrame(tick);
    }

    function detener() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
        pausedAt = performance.now();
      }
    }

    function dibujarEstrellasDecorativas(now) {
      for (const s of decorStars) {
        const tw = reducedMotion ? 1 : 0.5 + 0.5 * Math.sin(now * 0.001 * s.speed + s.phase);
        ctx.fillStyle = `rgba(${starRGB[0]},${starRGB[1]},${starRGB[2]},${(s.baseAlpha * tw).toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function tick(now) {
      if (!visible) { rafId = null; return; }
      ctx.clearRect(0, 0, cw, ch);
      dibujarEstrellasDecorativas(now);

      if (!ready || particles.length === 0) {
        // El logo todavía no terminó de decodificarse: seguimos
        // dibujando solo las estrellas de fondo hasta que esté listo.
        rafId = requestAnimationFrame(tick);
        return;
      }

      const elapsed = now - cycleStart;

      if (reducedMotion) {
        // Sin animación: el logo se dibuja directamente formado.
        for (const p of particles) {
          const [r, g, b] = p.colorTo;
          ctx.fillStyle = `rgba(${r},${g},${b},1)`;
          ctx.beginPath();
          ctx.arc(p.tx, p.ty, p.sizeFinal, 0, Math.PI * 2);
          ctx.fill();
        }
        rafId = requestAnimationFrame(tick);
        return;
      }

      if (cycleState === 0) {
        let allDone = true;
        for (const p of particles) {
          const localElapsed = Math.max(0, elapsed - p.delay);
          const t = clamp(localElapsed / duration, 0, 1);
          if (t < 1) allDone = false;
          dibujarParticula(p, easeOutCubic(t), now);
        }
        if (allDone) { cycleState = 1; cycleStart = now; }
      } else if (cycleState === 1) {
        for (const p of particles) dibujarParticula(p, 1, now);
        if (loop && elapsed > holdMs) {
          for (const p of particles) {
            p.posA = [p.tx, p.ty];
            p.posB = randomScatterPos();
            p.colorA = p.colorTo;
            p.colorB = starRGB;
          }
          cycleState = 2; cycleStart = now;
        }
      } else if (cycleState === 2) {
        const t = clamp(elapsed / DISPERSAL_MS, 0, 1);
        for (const p of particles) dibujarParticula(p, easeInCubic(t), now);
        if (t >= 1) { cycleState = 3; cycleStart = now; }
      } else if (cycleState === 3) {
        for (const p of particles) dibujarParticula(p, 1, now);
        if (elapsed > DISPERSED_HOLD_MS) {
          for (const p of particles) {
            const [sx, sy] = randomScatterPos();
            p.posA = [sx, sy];
            p.posB = [p.tx, p.ty];
            p.colorA = starRGB;
            p.colorB = p.colorTo;
          }
          cycleState = 0; cycleStart = now;
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    function dibujarParticula(p, t, now) {
      const x = lerp(p.posA[0], p.posB[0], t);
      const y = lerp(p.posA[1], p.posB[1], t);
      const rr = Math.round(lerp(p.colorA[0], p.colorB[0], t));
      const gg = Math.round(lerp(p.colorA[1], p.colorB[1], t));
      const bb = Math.round(lerp(p.colorA[2], p.colorB[2], t));
      const size = lerp(p.sizeStart, p.sizeFinal, t);
      let jx = 0, jy = 0;
      if (t > 0.98) {
        jx = Math.sin(now * 0.0016 + p.phase) * 0.6;
        jy = Math.cos(now * 0.0013 + p.phase * 1.3) * 0.6;
      }
      ctx.fillStyle = `rgba(${rr},${gg},${bb},1)`;
      ctx.beginPath();
      ctx.arc(x + jx, y + jy, size, 0, Math.PI * 2);
      ctx.fill();
    }

    // --- Puesta en marcha ---
    dimensionarCanvas();
    cargarLogo();

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visible = entry.isIntersecting;
          if (visible) {
            if (document.visibilityState !== "hidden") arrancar();
          } else {
            detener();
          }
        }
      },
      { threshold: 0.3 }
    );
    io.observe(root);

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") detener();
      else if (visible) arrancar();
    });

    mqReducedMotion.addEventListener?.("change", (e) => { reducedMotion = e.matches; });

    let resizeTimeout;
    const ro = new ResizeObserver(() => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        dimensionarCanvas();
        if (ready) actualizarObjetivos();
      }, 120);
    });
    ro.observe(root);
  })();
</script>