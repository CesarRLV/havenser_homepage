---
// Hero.astro
---

<section class="hero-section">
  <!-- Contenedor del fondo animado -->
  <div id="galaxy-container" class="galaxy-container"></div>
  
  <!-- Contenido Principal -->
  <div class="hero-content">
    <h1 class="hero-title">Innovación, Datos y <span class="text-gradient">Tecnología</span></h1>
    <p class="hero-subtitle">Innovación inteligente, ejecución impecable</p>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    background-color: #05050a; /* Fondo estilo espacio profundo */
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* El contenedor central de partículas */
  .galaxy-container {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Estilos base de las partículas generadas por JS */
  :global(.particle) {
    position: absolute;
    width: 4px;
    height: 4px;
    background-color: #00d2ff;
    border-radius: 50%;
    box-shadow: 0 0 10px #00d2ff, 0 0 20px #3a7bd5;
    opacity: 0;
    transform-origin: center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #ffffff;
    max-width: 800px;
    padding: 0 20px;
    /* Un ligero fondo de cristal para que el texto sea legible sobre la animación */
    background: rgba(5, 5, 10, 0.4);
    backdrop-filter: blur(4px);
    border-radius: 16px;
    padding: 3rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 300;
    color: #a0a5b5;
    letter-spacing: 0.05em;
  }

  .text-gradient {
    background: linear-gradient(to right, #00d2ff, #3a7bd5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

<script>
  import anime from 'animejs';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('galaxy-container');
    const particles = [];
    const targets = [];
    
    // Configuración del tamaño del monograma (H + A)
    const size = 130; 

    // Función para crear puntos a lo largo de una línea (vectores)
    function addLine(x1, y1, x2, y2, numDots) {
      for (let i = 0; i < numDots; i++) {
        targets.push({
          x: x1 + (x2 - x1) * (i / numDots),
          y: y1 + (y2 - y1) * (i / numDots)
        });
      }
    }

    // --- CONSTRUCCIÓN DEL MONOGRAMA (H y A traslapadas) ---
    // Letra H
    addLine(-80, -size, -80, size, 40); // Pata Izquierda
    addLine(80, -size, 80, size, 40);   // Pata Derecha
    addLine(-80, 0, 80, 0, 30);         // Barra central H

    // Letra A (Traslapada, usando el mismo centro geométrico)
    addLine(-80, size, 0, -size, 45);   // Diagonal izquierda
    addLine(80, size, 0, -size, 45);    // Diagonal derecha
    addLine(-40, 30, 40, 30, 20);       // Barra central A

    const numParticles = targets.length; // Total de puntos exactos para formar las letras

    // Generar partículas en posición de galaxia (espiral/circular)
    for (let i = 0; i < numParticles; i++) {
      const p = document.createElement('div');
      p.classList.add('particle');
      container.appendChild(p);
      particles.push(p);

      // Posición inicial aleatoria estilo galaxia (radio amplio)
      const angle = Math.random() * Math.PI * 2;
      const radius = 200 + Math.random() * 400; 
      
      const startX = Math.cos(angle) * radius;
      const startY = Math.sin(angle) * radius;

      // Colocamos las partículas en la galaxia inicial
      p.style.left = `${startX}px`;
      p.style.top = `${startY}px`;
    }

    // --- SECUENCIA DE ANIMACIÓN (Anime.js) ---
    const tl = anime.timeline({
      easing: 'easeInOutCubic'
    });

    // 1. Aparecen simulando la galaxia en rotación
    tl.add({
      targets: '.particle',
      opacity: [0, 0.8],
      scale: [0, Math.random() * 1.5 + 0.5],
      translateX: () => anime.random(-100, 100),
      translateY: () => anime.random(-100, 100),
      duration: 2000,
      delay: anime.stagger(5)
    })
    // 2. Convergen y se ordenan para formar la H y la A traslapadas
    .add({
      targets: '.particle',
      left: (el, i) => `${targets[i].x}px`,
      top: (el, i) => `${targets[i].y}px`,
      translateX: 0,
      translateY: 0,
      scale: 1,
      opacity: 1,
      duration: 3000,
      delay: anime.stagger(10, { from: 'center' }),
      easing: 'easeOutElastic(1, .8)'
    })
    // 3. Efecto final: parpadeo suave estilo energía o neón
    .add({
      targets: '.particle',
      opacity: [1, 0.4, 1],
      scale: [1, 1.2, 1],
      duration: 1500,
      delay: anime.stagger(20, { from: 'last', grid: [10, 10] }),
      loop: true,
      direction: 'alternate',
      easing: 'easeInOutSine'
    });
  });
</script>