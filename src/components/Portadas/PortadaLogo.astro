---
// Portada / Hero de la home (zona oscura de marca).
//
// - El texto y los botones son HTML puro: se pintan de inmediato (LCP) y
//   nunca dependen del 3D.
// - El 3D (Hero3D, isla de React con client:idle) se monta detrás, a la
//   derecha en escritorio y arriba/centrado en móvil, cuando el navegador
//   está libre. Mientras tanto (o si no hay WebGL / reduced-motion) se ve
//   un póster SVG estático.
// - La entrada del texto es un timeline de GSAP; al hacer scroll el
//   contenido se desvanece (scrub) mientras el núcleo 3D se expande.
import Hero3D from "../hero/Hero3D";
---

<header id="hero" class="hero zona-oscura">
  <div class="hero-fondo" aria-hidden="true">
    <Hero3D client:idle />
  </div>

  <div class="hero-contenido">
    <p class="eyebrow hero-anim">Consultoría en ingeniería, IA y ciencias exactas</p>
    <h1 class="hero-titulo">
      Innovación inteligente, <strong>ejecución impecable.</strong>
    </h1>
    <p class="hero-sub hero-anim">
      Agentes de IA que automatizan su operación, chatbots que atienden en WhatsApp las 24&nbsp;horas,
      marketing digital medible y software a la medida, con el rigor de un equipo de ingenieros y científicos.
    </p>
    <div class="hero-cta hero-anim">
      <a href="/contactanos" class="btn-oro">Cotiza tu solución</a>
      <a href="/soluciones/marketing-digital#calculadora" class="btn-borde">Arma tu paquete de marketing</a>
    </div>
    <p class="hero-confianza hero-anim">
      Equipo interdisciplinario con formación de posgrado · Proyectos B2B · Acompañamiento después del lanzamiento
    </p>
  </div>

  <a href="#soluciones" class="hero-scroll" aria-label="Ver soluciones">
    <span></span>
  </a>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    // Entrada. El <h1> solo se desplaza (nunca opacity: 0) para no retrasar el LCP.
    gsap
      .timeline({ defaults: { ease: 'power3.out', duration: 0.9 } })
      .from('.hero-titulo', { y: 24 })
      .from('.hero-anim', { autoAlpha: 0, y: 20, stagger: 0.12 }, '<0.1')
      .from('.hero-scroll', { autoAlpha: 0 }, '-=0.3');

    // Salida con scroll: el texto sube y se desvanece mientras el 3D se expande.
    gsap.to('.hero-contenido', {
      yPercent: -18,
      autoAlpha: 0.15,
      ease: 'none',
      scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true },
    });
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 112px 24px 72px;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* Contenedores de la isla 3D (las clases las pone Hero3D.tsx). */
  .hero-fondo :global(.hero-3d),
  .hero-fondo :global(.hero-canvas) {
    position: absolute;
    inset: 0;
  }
  .hero-fondo :global(.hero-canvas) { transition: opacity 1.2s ease; }
  /* Escritorio: la red se desvanece hacia el texto (izquierda) para no competir con la lectura. */
  @media (min-width: 768px) {
    .hero-fondo :global(.hero-canvas) {
      mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.25) 32%, #000 58%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.25) 32%, #000 58%);
    }
  }
  .hero-fondo :global(.poster-nucleo) {
    position: absolute;
    width: min(46vw, 560px);
    right: 6vw;
    top: 50%;
    transform: translateY(-50%);
  }

  .hero-contenido {
    position: relative;
    max-width: 720px;
    color: var(--text-light);
  }

  .hero-titulo {
    font-size: clamp(2.2rem, 5.6vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: #fff;
    text-wrap: balance;
  }
  .hero-titulo strong { color: var(--gold); font-weight: 700; }

  .hero-sub {
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: #b9c0cc;
    max-width: 560px;
    margin: 0 0 2rem;
    text-wrap: pretty;
  }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-cta .btn-borde { color: var(--text-light); border-color: rgba(230, 230, 240, 0.4); }

  .hero-confianza {
    margin: 1.75rem 0 0;
    font-size: 0.88rem;
    color: #8d94a1;
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 2px solid rgba(230, 230, 240, 0.35);
    border-radius: 14px;
  }
  .hero-scroll span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--gold);
    animation: rueda 1.8s ease-in-out infinite;
  }
  @keyframes rueda {
    0% { transform: translateY(0); opacity: 1; }
    80% { transform: translateY(14px); opacity: 0; }
    100% { opacity: 0; }
  }

  @media (min-width: 900px) {
    .hero { padding-left: 6vw; padding-right: 6vw; }
  }

  /* Móvil: franja superior reservada para el núcleo y el texto debajo,
     con un velo para que la red no compita con la lectura. */
  @media (max-width: 767px) {
    .hero { justify-content: flex-start; padding: calc(64px + 26svh) 18px 88px; }
    .hero-titulo { font-size: clamp(2.1rem, 9vw, 2.6rem); }
    .hero-fondo::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 28%, rgba(16, 25, 45, 0.85) 42%, #10192d 58%);
    }
    .hero-fondo :global(.poster-nucleo) {
      width: 26svh;
      right: calc(50% - 13svh);
      top: 76px;
      transform: none;
    }
  }
</style>
