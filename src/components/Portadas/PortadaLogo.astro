---
// Componente Hero con Animación de Circuito H
---

<header class="hero-circuito">

  <div class="header-content">
    <p class="hero-eyebrow">Consultoría en ingeniería, datos e IA</p>
    <h1>La complejidad operativa de tu empresa,<strong> resuelta con tecnología que sí se usa</strong></h1>
    <p class="hero-sub">
      Datos, inteligencia artificial, software a la medida e infraestructura cloud
      para operaciones B2B que necesitan resultados, no demos.
    </p>
    <div class="hero-cta">
      <a href="#contacto" class="btn-primary">Agenda una consultoría sin costo</a>
      <a href="#servicios" class="btn-secondary">Conoce nuestros servicios</a>
    </div>
    <p class="hero-trust">
      Equipo interdisciplinario con formación de posgrado · Proyectos B2B · Acompañamiento posterior al lanzamiento
    </p>
  </div>

  <canvas id="circuitoCanvas"></canvas>
</header>

<style>
  /* Contenedor principal de la portada */
  .hero-circuito {
    width: 100%;
    min-height: 100vh;
    position: sticky;

    overflow: hidden;
    display: flex;

    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 96px 20px 48px;
    box-sizing: border-box;
    background-color: var(--bg-main);
    top:0;
    z-index: 1;
  }

  #circuitoCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }

  .header-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: var(--text-light);
    padding: 0 20px;
    max-width: 900px;
    pointer-events: none; /* El texto no bloquea, pero los botones sí reciben clic (ver .hero-cta) */
  }

  .hero-eyebrow {
    font-family: 'Calibri', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(0.68rem, 2vw, 0.8rem);
    font-weight: 600;
    color: #c9a126;
    margin: 0 0 18px 0;
  }

  .header-content h1 {
    font-family: 'Georgia', serif;
    font-size: clamp(1.75rem, 4.6vw, 3.4rem);
    font-weight: 700;
    line-height: 1.18;
    margin: 0 0 20px 0;
    letter-spacing: -0.5px;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.9);
  }

  .header-content h1 strong {
    color: #c9a126;
  }

  .hero-sub {
    font-family: 'Calibri', sans-serif;
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    color: var(--text-muted);
    margin: 0 auto 32px auto;
    max-width: 640px;
    font-weight: 300;
    line-height: 1.6;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 10px;
    font-family: 'Calibri', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.3px;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: #c9a126;
    color: #10192d;
  }

  .btn-primary:hover {
    background: #e0b62c;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(201, 161, 38, 0.25);
  }

  .btn-secondary {
    border: 2px solid rgba(230, 230, 240, 0.4);
    color: var(--text-light);
  }

  .btn-secondary:hover {
    border-color: #c9a126;
    color: #c9a126;
  }

  .hero-trust {
    font-family: 'Calibri', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 28px 0 0 0;
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .hero-circuito {
      padding: 88px 18px 40px;
    }
  }
</style>

<script>
  // Astro empaquetará este script automáticamente para el cliente
    type Punto = {
        angulo: number;
        radioOrbita: number;
        velocidadOrbita: number;
        distorsion: number;
        radio: number;
        alpha: number;
        x: number;
        y: number;
        objetivoX: number | null;
        objetivoY: number | null;
    };

    type Nodo = { x: number; y: number };
    type Linea = { p1: Nodo; p2: Nodo };

    const canvasElement = document.getElementById('circuitoCanvas');
  
    if (canvasElement instanceof HTMLCanvasElement) { // Buena práctica: verificar que el elemento exista antes de ejecutar
        const canvas: HTMLCanvasElement = canvasElement;
        const ctxResult = canvas.getContext('2d');

        if (!ctxResult || !canvas.parentElement) {
            throw new Error('No se pudo inicializar el canvas del circuito.');
        }

        const ctx: CanvasRenderingContext2D = ctxResult;

    function resizeCanvas() {
                canvas.width = canvas.parentElement!.offsetWidth;
                canvas.height = canvas.parentElement!.offsetHeight;
        generarEstructuraH(); 
    }

    const numPuntos = 120;
        const puntos: Punto[] = [];

        let nodosCircuito: Nodo[] = [];
        let lineasCircuito: Linea[] = [];
    let circuitoIniciado = false;

    function initPuntos() {
        puntos.length = 0;
        for (let i = 0; i < numPuntos; i++) {
            puntos.push({
                angulo: Math.random() * Math.PI * 2,
                radioOrbita: Math.random() * (Math.min(canvas.width, canvas.height) * 0.35) + 20,
                velocidadOrbita: (Math.random() - 0.5) * 0.03,
                distorsion: (Math.random() - 0.5) * 0.5,
                radio: Math.random() * 2 + 1,
                alpha: Math.random() * 0.7 + 0.3,
                x: 0,
                y: 0,
                objetivoX: null,
                objetivoY: null
            });
        }
    }

    function generarEstructuraH() {
        nodosCircuito = [];
        lineasCircuito = [];

        const cx = canvas.width / 2;
        const cy = (canvas.height / 2) - 50;

        const hAncho = 110;
        const hAlto = 150;
        const hMitadA = hAncho / 2;
        const hMitadH = hAlto / 2;

        const puntosH = [];
        const pasosVerticales = 6;
        const pasosHorizontales = 4;

        // Columna Izquierda H
        for (let i = 0; i <= pasosVerticales; i++) {
            puntosH.push({ x: cx - hMitadA, y: cy - hMitadH + (hAlto / pasosVerticales) * i });
        }
        // Columna Derecha H
        for (let i = 0; i <= pasosVerticales; i++) {
            puntosH.push({ x: cx + hMitadA, y: cy - hMitadH + (hAlto / pasosVerticales) * i });
        }
        // Barra Horizontal Central H
        for (let i = 1; i < pasosHorizontales; i++) {
            puntosH.push({ x: cx - hMitadA + (hAncho / pasosHorizontales) * i, y: cy });
        }

        // Marco / Borde del Circuito
        const marcoAncho = 260;
        const marcoAlto = 200;
        const mMitadA = marcoAncho / 2;
        const mMitadH = marcoAlto / 2;

        const puntosBorde = [
            { x: cx - mMitadA, y: cy - mMitadH },
            { x: cx + mMitadA, y: cy - mMitadH },
            { x: cx + mMitadA, y: cy + mMitadH },
            { x: cx - mMitadA, y: cy + mMitadH },
            { x: cx, y: cy - mMitadH },
            { x: cx, y: cy + mMitadH },
            { x: cx - mMitadA, y: cy },
            { x: cx + mMitadA, y: cy }
        ];

        nodosCircuito = [...puntosH, ...puntosBorde];

        for (let i = 0; i < nodosCircuito.length; i++) {
            for (let j = i + 1; j < nodosCircuito.length; j++) {
                const p1 = nodosCircuito[i];
                const p2 = nodosCircuito[j];
                const dist = Math.hypot(p1.x - p2.x, p1.y - p2.y);

                if (dist < 70 || (Math.abs(p1.x - p2.x) < 5 && dist < 110) || (Math.abs(p1.y - p2.y) < 5 && dist < 110)) {
                    lineasCircuito.push({ p1, p2 });
                }
            }
        }

        if (circuitoIniciado) {
            asignarObjetivos();
        }
    }

    function asignarObjetivos() {
        for (let i = 0; i < puntos.length; i++) {
            const nodoTarget = nodosCircuito[i % nodosCircuito.length];
            puntos[i].objetivoX = nodoTarget.x;
            puntos[i].objetivoY = nodoTarget.y;
        }
    }

    function dibujarFondoDifuminado() {
        const cx = canvas.width / 2;
        const cy = (canvas.height / 2) - 50;
        const maxRadius = Math.max(canvas.width, canvas.height) * 0.8;

        const gradiente = ctx.createRadialGradient(cx, cy, 20, cx, cy, maxRadius);
        // Ajuste de colores para integrarse con --bg-main (#111b2c)
        gradiente.addColorStop(0, '#192232'); 
        gradiente.addColorStop(0.6, '#111b2c');
        gradiente.addColorStop(1, '#010206');

        ctx.fillStyle = gradiente;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    function animar() {
        dibujarFondoDifuminado();

        const cx = canvas.width / 2;
        const cy = (canvas.height / 2) - 50;

        if (circuitoIniciado) {
            ctx.save();
            ctx.lineWidth = 1.5;
            ctx.strokeStyle = 'rgba(0, 162, 255, 0.4)';
            ctx.shadowColor = '#0088ff';
            ctx.shadowBlur = 10;

            lineasCircuito.forEach(linea => {
                ctx.beginPath();
                ctx.moveTo(linea.p1.x, linea.p1.y);
                ctx.lineTo(linea.p2.x, linea.p2.y);
                ctx.stroke();
            });
            ctx.restore();
        }

        for (let i = 0; i < puntos.length; i++) {
            const p = puntos[i];

            if (!circuitoIniciado) {
                p.angulo += p.velocidadOrbita;
                p.radioOrbita += p.distorsion;

                if (p.radioOrbita < 30 || p.radioOrbita > Math.min(canvas.width, canvas.height) * 0.4) {
                    p.distorsion *= -1;
                }

                p.x = cx + Math.cos(p.angulo) * p.radioOrbita;
                p.y = cy + Math.sin(p.angulo) * p.radioOrbita;

            } else {
                if (p.objetivoX !== null && p.objetivoY !== null) {
                    p.x += (p.objetivoX - p.x) * 0.025;
                    p.y += (p.objetivoY - p.y) * 0.025;
                }
            }

            ctx.save();
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radio, 0, Math.PI * 2);
            ctx.fillStyle = '#61dafb';
            ctx.shadowColor = '#00d2ff';
            ctx.shadowBlur = circuitoIniciado ? 8 : 6;
            ctx.fill();
            ctx.restore();
        }

        requestAnimationFrame(animar);
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();
    initPuntos();
    animar();

    setTimeout(() => {
        circuitoIniciado = true;
        asignarObjetivos();
    }, 3500);
  }
</script>