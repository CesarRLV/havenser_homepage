---
// Portada / Hero.
//
// Fondo oscuro a propósito: es una de las dos únicas zonas oscuras del
// sitio (la otra es el Footer), pensadas como "ancla de marca". El resto
// del sitio es claro.
//
// Layout: todo el texto está alineado a la izquierda. La animación de
// fondo (OlaPuntos: una malla de puntos que se mueve como una ola) ocupa
// las 100% del hero, pero se le aplica una máscara CSS (mask-image) que
// la desvanece cerca del borde izquierdo y la deja a plena vista desde
// ~42% del ancho hacia la derecha. Así la ola queda "alineada a la
// derecha" y ocupa visualmente más espacio del lado derecho sin tener que
// dividir el layout en columnas (funciona igual en cualquier ancho de
// pantalla, incluido mobile).
import OlaPuntos from "../animaciones/OlaPuntos.astro";
---

<header class="hero-circuito">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-viz">
      <OlaPuntos />
    </div>
  </div>

  <div class="header-content">
    <p class="hero-eyebrow">Consultoría en ingeniería, datos e IA</p>
    <h1>La complejidad operativa de tu empresa,<strong> resuelta con tecnología que sí se usa</strong></h1>
    <p class="hero-sub">
      Datos, inteligencia artificial, software a la medida e infraestructura cloud
      para operaciones B2B que necesitan resultados, no demos.
    </p>
    <div class="hero-cta">
      <a href="#contacto" class="btn-primary">Agenda una consultoría sin costo</a>
      <a href="#servicios" class="btn-secondary">Conoce nuestros servicios</a>
    </div>
    <p class="hero-trust">
      Equipo interdisciplinario con formación de posgrado · Proyectos B2B · Acompañamiento posterior al lanzamiento
    </p>
  </div>
</header>

<style>
  /* Contenedor principal de la portada */
  .hero-circuito {
    width: 100%;
    min-height: 100vh;
    position: sticky;

    overflow: hidden;
    display: flex;

    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 96px 24px 48px;
    box-sizing: border-box;
    background: radial-gradient(120% 90% at 50% 15%, #192232 0%, #111b2c 55%, #05070d 100%);
    top: 0;
    z-index: 1;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Respiración muy lenta para reforzar la sensación de calma */
    animation: respirar 9s ease-in-out infinite;
  }

  .hero-viz {
    position: absolute;
    inset: 0;
    opacity: 0.8;
    filter: saturate(0.9);
    /* Desvanece la ola cerca del texto (izquierda) y la deja a plena
       vista desde ~42% del ancho hacia la derecha: así ocupa más
       espacio visual del lado derecho sin necesitar un layout a 2
       columnas. */
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.2) 24%, #000 42%, #000 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.2) 24%, #000 42%, #000 100%);
  }

  @keyframes respirar {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
    }
  }

  .header-content {
    position: relative;
    z-index: 2;
    text-align: left;
    color: var(--text-light);
    padding: 0;
    max-width: 620px;
    pointer-events: none; /* El texto no bloquea, pero los botones sí reciben clic (ver .hero-cta) */
  }

  .hero-eyebrow {
    font-family: 'Calibri', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(0.68rem, 2vw, 0.8rem);
    font-weight: 600;
    color: #c9a126;
    margin: 0 0 18px 0;
  }

  .header-content h1 {
    font-family: 'Georgia', serif;
    font-size: clamp(1.75rem, 4.6vw, 3.4rem);
    font-weight: 700;
    line-height: 1.18;
    margin: 0 0 20px 0;
    letter-spacing: -0.5px;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.9);
  }

  .header-content h1 strong {
    color: #c9a126;
  }

  .hero-sub {
    font-family: 'Calibri', sans-serif;
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    color: var(--text-muted);
    margin: 0 0 32px 0;
    max-width: 560px;
    font-weight: 300;
    line-height: 1.6;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    justify-content: flex-start;
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 10px;
    font-family: 'Calibri', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.3px;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: #c9a126;
    color: #10192d;
  }

  .btn-primary:hover {
    background: #e0b62c;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(201, 161, 38, 0.25);
  }

  .btn-secondary {
    border: 2px solid rgba(230, 230, 240, 0.4);
    color: var(--text-light);
  }

  .btn-secondary:hover {
    border-color: #c9a126;
    color: #c9a126;
  }

  .hero-trust {
    font-family: 'Calibri', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 28px 0 0 0;
    opacity: 0.8;
  }

  @media (min-width: 900px) {
    .hero-circuito {
      padding-left: 6vw;
      padding-right: 6vw;
    }
  }

  @media (max-width: 640px) {
    .hero-circuito {
      padding: 88px 18px 40px;
    }
    .hero-viz {
      opacity: 0.3;
      /* En mobile el texto ocupa casi todo el ancho: se retrasa el
         inicio de la ola para que no compita con la lectura. */
      mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.15) 45%, #000 68%, #000 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.15) 45%, #000 68%, #000 100%);
    }
  }
</style>
