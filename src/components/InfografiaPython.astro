---

<div class="infographic-wrapper w-full flex justify-center py-10 bg-gray-100">
  <div class="infographic-container relative bg-white shadow-2xl overflow-hidden">
    
    <div class="p-8 text-center bg-slate-900 text-white">
      <h1 class="text-4xl font-black mb-2">Python para Ingenieros Automotrices</h1>
      <p class="text-xl text-blue-300">Sinergia Tecnológica</p>
    </div>
    
    </div>
</div>

<style>
  .infographic-wrapper {
    /* Fondo para contrastar con la infografía blanca */
    background-color: #f3f4f6; 
  }
  
  .infographic-container {
    width: 100%;
    max-width: 1080px; 
   
    min-height: 1000px; 
    transform-origin: top center;
  }


  @media (max-width: 1200px) {
    .infographic-container {
      max-width: 100%;
      height: auto;
    }
  }
</style>