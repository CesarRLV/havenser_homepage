---
// src/components/EtiquetaInfo.astro

// Definimos las propiedades que recibirá el componente
interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<section class="px-20 py-16  mx-auto bg-gray-100 border-l-4 border-gray-400 rounded-r-lg shadow-sm my-6">
  {/* Título */}
  <h3 class="text-3xl font-bold text-gray-800 mb-2 uppercase tracking-wide" >
    {titulo}
  </h3>
  
  {/* Cuerpo del mensaje */}
  <div class="text-gray-600 leading-relaxed">
    <slot />
  </div>
</section>