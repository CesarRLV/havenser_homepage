---
// Home: "Así automatizamos su operación" (zona oscura).
// En escritorio la sección se fija (pin) y los pasos se activan uno a uno
// conforme se hace scroll (GSAP ScrollTrigger con scrub). En móvil y con
// reduced-motion es una lista normal con revelado simple.
import { getSolucion } from "../data/soluciones";
const { proceso } = getSolucion("automatizacion-ia");
---

<section id="proceso" class="proceso zona-oscura">
  <div class="proceso-grid max-w-7xl mx-auto px-6 lg:px-8">
    <div class="proceso-intro">
      <p class="eyebrow">Agentes IA y automatización</p>
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
        Así convertimos horas de trabajo manual en procesos que corren solos
      </h2>
      <p class="text-lg text-[#b9c0cc]">
        Agentes de inteligencia artificial conectados a su correo, Excel, ERP, CRM y WhatsApp, con una persona de su equipo supervisando lo importante.
      </p>
      <a href="/soluciones/automatizacion-ia" class="btn-oro mt-2">Calcule cuántas horas puede ahorrar</a>
    </div>

    <div class="relative">
    <span class="proceso-linea" aria-hidden="true"><span class="proceso-linea-fill"></span></span>
    <ol class="proceso-pasos">
      {proceso.map((p, i) => (
        <li class="proceso-paso">
          <span class="num">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="text-xl md:text-2xl font-bold text-white mb-2">{p.titulo}</h3>
            <p class="text-[#b9c0cc] m-0">{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Móvil / tablet: revelado simple, sin pin.
  mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
    gsap.from('.proceso-paso', {
      autoAlpha: 0,
      y: 24,
      stagger: 0.12,
      duration: 0.7,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.proceso-pasos', start: 'top 85%', once: true },
    });
  });

  // Escritorio: sección fijada y pasos activados con el scroll.
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const pasos = gsap.utils.toArray<HTMLElement>('.proceso-paso');
    gsap.set(pasos, { opacity: 0.25 });

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: '#proceso', start: 'top top', end: '+=160%', pin: true, scrub: 0.6 },
    });
    tl.fromTo('.proceso-linea-fill', { scaleY: 0 }, { scaleY: 1, duration: pasos.length }, 0);
    pasos.forEach((paso, i) => {
      tl.to(paso, { opacity: 1, duration: 0.4 }, i + 0.1)
        .fromTo(paso.querySelector('.num'), { scale: 0.8 }, { scale: 1, color: '#10192d', backgroundColor: '#c9a126', duration: 0.4 }, i + 0.1);
    });
  });
</script>

<style>
  .proceso { position: relative; padding: 7rem 0; overflow: hidden; }
  .proceso-grid { display: grid; gap: 3.5rem; align-items: center; }
  .proceso-intro p:not(.eyebrow) { margin-bottom: 2rem; }

  .proceso-pasos {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.25rem;
    display: grid;
    gap: 2.25rem;
  }
  .proceso-linea {
    position: absolute;
    left: 28px;
    top: 28px;
    bottom: 28px;
    width: 2px;
    background: rgba(110, 123, 144, 0.35);
  }
  .proceso-linea-fill {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform-origin: top center;
  }
  .proceso-paso { position: relative; display: flex; gap: 1.5rem; align-items: flex-start; }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(201, 161, 38, 0.6);
    background: #10192d;
    color: var(--gold);
    font-weight: 700;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .proceso { min-height: 100vh; display: flex; align-items: center; }
    .proceso-grid { grid-template-columns: 1fr 1fr; gap: 6rem; }
  }
</style>
