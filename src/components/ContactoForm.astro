---
import IconoFacebook from "./IconosRedesSociales/IconoFacebook.astro";
import IconoGmail from "./IconosRedesSociales/IconoGmail.astro";
import IconoLinkedin from "./IconosRedesSociales/IconoLinkedin.astro";
import IconoWhatsApp from "./IconosRedesSociales/IconoWhatsApp.astro";

// src/components/ContactoForm.astro
//
// Formulario multi-step (wizard) de 4 pasos:
//   1. Qué necesita el visitante (interés)
//   2. Datos de contacto
//   3. Su reto / mensaje
//   4. Confirmación y envío
//
// Los 4 pasos viven en el mismo <form>, solo se muestra uno a la vez con
// JS (ver <script> al final). El envío real (fetch al endpoint, honeypot,
// mensajes de estado) es el mismo que ya funcionaba, solo se disparó ahora
// desde el botón del último paso en vez de un único botón "Enviar".
//
// Este componente se reutiliza tal cual en src/pages/contactanos.astro.

const intereses = [
  "Marketing digital",
  "Agentes IA y automatización",
  "Chatbot WhatsApp / Telegram",
  "IA & Datos",
  "Desarrollo de software",
  "Infraestructura Cloud",
  "Cursos y capacitación",
  "Otro / no estoy seguro",
];
---

<section id="contacto" class="py-16 md:py-24 bg-[var(--bg-light)] relative z-20">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">

    <div class="relative bg-white border border-[var(--border-soft)] rounded-2xl shadow-[0_20px_60px_rgba(16,25,45,0.08)] overflow-hidden flex flex-col md:flex-row min-h-[680px]">

      <!-- Lado Izquierdo: Imagen con Corte Diagonal -->
      <div class="w-full h-56 md:h-full md:absolute md:inset-y-0 md:left-0 md:w-[44%] diagonal-split z-0 bg-[#10192d]">
        <img
          src="/contactForm.jpg"
          alt="Consultoría Tecnológica Havenser"
          class="w-full h-full object-cover opacity-80"
        />
        <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-[#10192d] via-[#10192d]/70 to-transparent pointer-events-none"></div>
        <div class="absolute inset-0 hidden md:flex flex-col justify-end p-10 text-white pointer-events-none">
          <p class="text-[#c9a126] text-sm font-semibold uppercase tracking-[0.18em] mb-3">Hablemos</p>
          <h2 class="text-3xl font-bold mb-3" style="font-family: Georgia, serif;">Transformemos su Operación</h2>
          <p class="text-white/80" style="font-family: Calibri, sans-serif;">¿Tiene un desafío técnico complejo? En 4 pasos rápidos nos cuenta y le contactamos.</p>
        </div>
      </div>

      <!-- Lado Derecho: Wizard -->
      <div class="w-full md:w-[56%] md:ml-auto p-6 sm:p-10 md:p-14 relative z-10 flex flex-col">

        <!-- Progreso -->
        <div class="flex items-center gap-2 mb-8" role="progressbar" aria-valuemin="1" aria-valuemax="4" id="progreso-wizard">
          {[1, 2, 3, 4].map((n) => (
            <div class="progreso-paso flex-1 h-1.5 rounded-full bg-[var(--border-soft)]" data-paso={n}></div>
          ))}
        </div>

        <form id="contacto-form" class="flex flex-col grow">

          <!-- Honeypot anti-spam: oculto para humanos, tentador para bots -->
          <div class="absolute w-px h-px overflow-hidden -m-px p-0 border-0" aria-hidden="true">
            <label for="empresa-web">No llenar este campo</label>
            <input type="text" id="empresa-web" name="empresa_web" tabindex="-1" autocomplete="off" />
          </div>

          <!-- PASO 1: Interés -->
          <div class="wizard-step" data-step="1">
            <p class="text-sm font-semibold text-[#c9a126] uppercase tracking-wide mb-1">Paso 1 de 4</p>
            <h3 class="text-2xl font-bold text-[#10192d] mb-6" style="font-family: Georgia, serif;">¿Qué necesita su empresa?</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {intereses.map((op) => (
                <label class="interes-opcion cursor-pointer border border-[var(--border-soft)] rounded-xl px-4 py-3 text-sm font-medium text-[#3e4b61] hover:border-[#c9a126] transition-colors duration-200 flex items-center gap-2">
                  <input type="radio" name="interes" value={op} class="accent-[#c9a126]" required />
                  {op}
                </label>
              ))}
            </div>
          </div>

          <!-- PASO 2: Datos de contacto -->
          <div class="wizard-step hidden" data-step="2">
            <p class="text-sm font-semibold text-[#c9a126] uppercase tracking-wide mb-1">Paso 2 de 4</p>
            <h3 class="text-2xl font-bold text-[#10192d] mb-6" style="font-family: Georgia, serif;">Sus datos de contacto</h3>
            <div class="space-y-4">
              <div class="campo">
                <label for="nombre">Nombre Completo</label>
                <input type="text" id="nombre" name="nombre" placeholder="Ingresa tu nombre" required />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="campo">
                  <label for="email">Correo Corporativo</label>
                  <input type="email" id="email" name="email" placeholder="nombre@empresa.com" required />
                </div>
                <div class="campo">
                  <label for="empresa">Empresa <span class="opcional">(opcional)</span></label>
                  <input type="text" id="empresa" name="empresa" placeholder="Nombre de tu empresa" />
                </div>
              </div>
              <div class="campo">
                <label for="tel">Teléfono de contacto <span class="opcional">(opcional)</span></label>
                <input type="tel" id="tel" name="telefono" placeholder="+52 77668843" />
              </div>
            </div>
          </div>

          <!-- PASO 3: Su reto -->
          <div class="wizard-step hidden" data-step="3">
            <p class="text-sm font-semibold text-[#c9a126] uppercase tracking-wide mb-1">Paso 3 de 4</p>
            <h3 class="text-2xl font-bold text-[#10192d] mb-6" style="font-family: Georgia, serif;">Cuéntenos su reto</h3>
            <div class="space-y-4">
              <div class="campo">
                <label for="asunto">Asunto <span class="opcional">(opcional)</span></label>
                <input type="text" id="asunto" name="asunto" placeholder="Motivo de tu mensaje" />
              </div>
              <div class="campo">
                <label for="mensaje">Mensaje</label>
                <textarea id="mensaje" name="mensaje" rows="5" placeholder="Cuéntanos sobre los cuellos de botella de tu organización..." required></textarea>
              </div>
            </div>
          </div>

          <!-- PASO 4: Confirmación -->
          <div class="wizard-step hidden" data-step="4">
            <p class="text-sm font-semibold text-[#c9a126] uppercase tracking-wide mb-1">Paso 4 de 4</p>
            <h3 class="text-2xl font-bold text-[#10192d] mb-6" style="font-family: Georgia, serif;">Confirme y envíe</h3>
            <div id="resumen-wizard" class="bg-[var(--bg-light)] border border-[var(--border-soft)] rounded-xl p-5 text-sm text-[#3e4b61] space-y-1.5 mb-6"></div>

            <div class="flex gap-4 justify-center mb-2">
              <IconoLinkedin/>
              <IconoFacebook/>
              <IconoWhatsApp/>
              <IconoGmail/>
            </div>
          </div>

          <!-- Navegación del wizard -->
          <div class="mt-auto pt-8 flex items-center justify-between gap-4">
            <button type="button" id="btn-atras" class="btn-secundario hidden">Atrás</button>
            <div class="grow"></div>
            <button type="button" id="btn-siguiente" class="btn-primario">Siguiente</button>
            <button type="submit" id="btn-enviar" class="btn-primario hidden">Enviar Solicitud</button>
          </div>

          <!-- Mensaje de estado (éxito / error) -->
          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="hidden text-center text-sm rounded-lg px-4 py-3 mt-4"
          >
          </p>

        </form>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { CLAVE_PRECARGA_CONTACTO } from '../data/sitio';

  const form = document.querySelector<HTMLFormElement>('#contacto-form');
  const endpoint = 'https://r8xpf2mp58.execute-api.us-east-2.amazonaws.com/prod/contacto';
  const statusEl = document.querySelector<HTMLParagraphElement>('#form-status');
  const pasos = Array.from(document.querySelectorAll<HTMLElement>('.wizard-step'));
  const progresoPasos = Array.from(document.querySelectorAll<HTMLElement>('.progreso-paso'));
  const btnAtras = document.querySelector<HTMLButtonElement>('#btn-atras');
  const btnSiguiente = document.querySelector<HTMLButtonElement>('#btn-siguiente');
  const btnEnviar = document.querySelector<HTMLButtonElement>('#btn-enviar');
  const resumenEl = document.querySelector<HTMLDivElement>('#resumen-wizard');
  const totalPasos = pasos.length;
  let pasoActual = 1;
  const prefiereMenosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function mostrarEstado(mensaje: string, tipo: 'ok' | 'error') {
    if (!statusEl) return;
    statusEl.textContent = mensaje;
    statusEl.classList.remove('hidden');
    if (tipo === 'ok') {
      statusEl.style.cssText = 'background:#f2f8f1;color:#2f6f3e;border:1px solid rgba(47,111,62,0.25);';
    } else {
      statusEl.style.cssText = 'background:#fbeeee;color:#a23c3c;border:1px solid rgba(162,60,60,0.25);';
    }
  }

  function validarPaso(paso: HTMLElement): boolean {
    const campos = Array.from(paso.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea'));
    for (const campo of campos) {
      if (!campo.checkValidity()) {
        campo.reportValidity();
        return false;
      }
    }
    return true;
  }

  function actualizarProgreso() {
    progresoPasos.forEach((barra, i) => {
      barra.style.backgroundColor = i < pasoActual ? '#c9a126' : '';
    });
  }

  function construirResumen() {
    if (!form || !resumenEl) return;
    const data = new FormData(form);
    const filas = [
      ['Interés', data.get('interes')],
      ['Nombre', data.get('nombre')],
      ['Correo', data.get('email')],
      ['Empresa', data.get('empresa') || '—'],
      ['Teléfono', data.get('telefono') || '—'],
      ['Mensaje', data.get('mensaje')],
    ];
    resumenEl.innerHTML = filas
      .map(([etiqueta, valor]) => `<p><strong class="text-[#10192d]">${etiqueta}:</strong> ${String(valor ?? '').slice(0, 200)}</p>`)
      .join('');
  }

  function irAPaso(n: number) {
    const anterior = pasos[pasoActual - 1];
    const siguiente = pasos[n - 1];
    if (!siguiente) return;

    if (n === totalPasos) construirResumen();

    // El cambio de paso (mostrar/ocultar) es SIEMPRE inmediato y síncrono:
    // la funcionalidad del wizard nunca debe depender de que una animación
    // termine (una pestaña en segundo plano puede pausar las animaciones
    // indefinidamente). `animate()` de abajo es solo un efecto visual de
    // acompañamiento, no controla el estado.
    anterior?.classList.add('hidden');
    siguiente.classList.remove('hidden');

    if (!prefiereMenosMovimiento) {
      gsap.fromTo(siguiente, { autoAlpha: 0, x: 12 }, { autoAlpha: 1, x: 0, duration: 0.3, ease: 'power2.out' });
    }

    pasoActual = n;
    btnAtras?.classList.toggle('hidden', pasoActual === 1);
    btnSiguiente?.classList.toggle('hidden', pasoActual === totalPasos);
    btnEnviar?.classList.toggle('hidden', pasoActual !== totalPasos);
    actualizarProgreso();
  }

  btnSiguiente?.addEventListener('click', () => {
    const pasoEl = pasos[pasoActual - 1];
    if (pasoEl && !validarPaso(pasoEl)) return;
    irAPaso(pasoActual + 1);
  });

  btnAtras?.addEventListener('click', () => {
    irAPaso(pasoActual - 1);
  });

  actualizarProgreso();

  // Precarga desde las calculadoras (/soluciones/*): solo viaja la
  // configuración elegida (paquete, complementos, horas), nunca datos
  // personales. Se consume una sola vez.
  try {
    const precarga = JSON.parse(sessionStorage.getItem(CLAVE_PRECARGA_CONTACTO) || 'null');
    if (precarga && form) {
      sessionStorage.removeItem(CLAVE_PRECARGA_CONTACTO);
      const radio = form.querySelector<HTMLInputElement>(`input[name="interes"][value="${CSS.escape(precarga.interes)}"]`);
      if (radio) radio.checked = true;
      const asunto = form.querySelector<HTMLInputElement>('#asunto');
      const mensaje = form.querySelector<HTMLTextAreaElement>('#mensaje');
      if (asunto && precarga.asunto) asunto.value = precarga.asunto;
      if (mensaje && precarga.mensaje) mensaje.value = precarga.mensaje;
    }
  } catch {
    // sessionStorage bloqueado (modo privado, etc.): el formulario funciona igual.
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const ultimoPaso = pasos[totalPasos - 1];
    if (ultimoPaso && !validarPaso(ultimoPaso)) return;

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries()) as Record<string, string>;

    // Si el honeypot viene lleno, es un bot: fingimos éxito y no enviamos nada.
    if (payload.empresa_web) {
      form.reset();
      mostrarEstado('Tu solicitud fue enviada correctamente. Te contactaremos pronto.', 'ok');
      return;
    }
    delete payload.empresa_web;

    statusEl?.classList.add('hidden');

    if (btnEnviar) {
      btnEnviar.disabled = true;
      btnEnviar.textContent = 'Enviando...';
    }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error(`La solicitud fallo con estado ${response.status}`);
      }

      form.reset();
      mostrarEstado('Tu solicitud fue enviada correctamente. Te contactaremos pronto.', 'ok');
      irAPaso(1);
    } catch (error) {
      console.error('Error al enviar el formulario de contacto:', error);
      mostrarEstado(
        'No fue posible enviar tu solicitud. Vuelve a intentarlo o escríbenos a consultoria@havenser.com.',
        'error',
      );
    } finally {
      if (btnEnviar) {
        btnEnviar.disabled = false;
        btnEnviar.textContent = 'Enviar Solicitud';
      }
    }
  });
</script>

<style>
  .diagonal-split {
    clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
  }
  @media (min-width: 768px) {
    .diagonal-split {
      clip-path: polygon(0 0, 78% 0, 100% 100%, 0 100%);
    }
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .campo label {
    font-family: 'Calibri', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #3e4b61;
  }
  .campo .opcional {
    font-weight: 400;
    color: #8d94a1;
  }
  .campo input,
  .campo textarea {
    font-family: 'Calibri', sans-serif;
    width: 100%;
    background: #fff;
    border: 1px solid var(--border-soft);
    color: #10192d;
    border-radius: 0.6rem;
    padding: 0.75rem 1rem;
    transition: all 0.25s ease;
  }
  .campo input:focus,
  .campo textarea:focus {
    outline: none;
    border-color: #c9a126;
    box-shadow: 0 0 0 3px rgba(201, 161, 38, 0.15);
  }
  .campo textarea {
    resize: none;
  }

  .interes-opcion:has(input:checked) {
    border-color: #c9a126;
    background: rgba(201, 161, 38, 0.08);
    color: #10192d;
  }

  .btn-primario {
    font-family: 'Calibri', sans-serif;
    background: #10192d;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 0.6rem;
    padding: 0.9rem 2rem;
    transition: all 0.25s ease;
  }
  .btn-primario:hover:not(:disabled) {
    background: #1c2c47;
    transform: translateY(-1px);
  }
  .btn-primario:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .btn-secundario {
    font-family: 'Calibri', sans-serif;
    background: transparent;
    color: #3e4b61;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--border-soft);
    border-radius: 0.6rem;
    padding: 0.85rem 1.5rem;
    transition: all 0.25s ease;
  }
  .btn-secundario:hover {
    border-color: #10192d;
    color: #10192d;
  }
</style>
