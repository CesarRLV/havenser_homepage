<section id="contacto" class="seccion-contacto bg-dark">
    <div class="container">
        <h2>Contáctanos</h2>
        
        <p>¿Tienes un proyecto en mente? Hablemos.</p>
        <form class="formulario" onsubmit="event.preventDefault();">
            <div class="form-group">
                <label for="nombre">Nombre Completo</label>
                <input
                    type="text"
                    id="nombre"
                    placeholder="Tu nombre"
                    required
                />
            </div>
            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input
                    type="email"
                    id="email"
                    placeholder="tu@correo.com"
                    required
                />
            </div>
            <div class="form-group">
                <label for="asunto">Asunto</label>
                <input
                    type="text"
                    id="asunto"
                    placeholder="Motivo de tu mensaje"
                />
            </div>
            <div class="form-group">
                <label for="mensaje">Mensaje</label>
                <textarea
                    id="mensaje"
                    rows="4"
                    placeholder="Cuéntanos sobre tu proyecto..."></textarea>
            </div>
            <button type="submit" class="btn-submit">Enviar Mensaje</button>
        </form>
    </div>
</section>

<style>
  .seccion-contacto {
    background-color: var(--bg-main); /* #111b2c */
    padding: 6rem 2rem;
  }

  .formulario-container {
    max-width: 600px;
    margin: 0 auto;
    background-color: var(--bg-surface); /* #192232 */
    border: 1px solid var(--accent);
    padding: 3rem;
    border-radius: 8px;
  }

  .formulario h2 {
    margin-bottom: 2rem;
    text-align: center;
  }

  .form-group {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-family: 'Calibri', sans-serif;
    color: var(--text-light);
    font-size: 1rem;
  }

  /* Inputs de Alta Gama Tecnológica */
  .form-group input, 
  .form-group textarea {
    font-family: 'Calibri', sans-serif;
    background-color: var(--bg-main); /* #111b2c */
    border: 1px solid var(--accent); /* #3e4b61 */
    color: var(--text-light);
    padding: 0.8rem;
    border-radius: 4px;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .form-group input:focus, 
  .form-group textarea:focus {
    border-color: var(--text-light); /* Resalta en #e6e6f0 al escribir */
    box-shadow: 0 0 8px rgba(230, 230, 240, 0.1);
  }

  .btn-submit {
    font-family: 'Calibri', sans-serif;
    width: 100%;
    background-color: var(--accent); /* #3e4b61 */
    color: var(--text-light);
    border: 1px solid transparent;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: bold;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .btn-submit:hover {
    background-color: transparent;
    border-color: var(--text-light);
    transform: translateY(-2px);
  }
</style>
