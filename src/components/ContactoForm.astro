---
import IconoFacebook from "./IconosRedesSociales/IconoFacebook.astro";
import IconoGmail from "./IconosRedesSociales/IconoGmail.astro";
import IconoLinkedin from "./IconosRedesSociales/IconoLinkedin.astro";
import IconoWhatsApp from "./IconosRedesSociales/IconoWhatsApp.astro";

// src/components/ContactoForm.astro
---

<section id="contacto" class="py-12 bg-[#10192d] relative z-20">
  <div class="max-w-8xl mx-auto px-6 lg:px-8">
    
    <!-- Contenedor Principal (Color de Superficie Havenser) -->
    <div class="relative bg-[#152036] border border-[#3e4b61] rounded-2xl shadow-2xl overflow-hidden flex flex-col md:flex-row min-h-[700px]">
      
      <!-- Lado Izquierdo: Imagen con Corte Diagonal -->
      <div class="w-full h-72 md:h-full md:absolute md:inset-y-0 md:left-0 md:w-[56%] diagonal-split z-0 bg-[#7985a0]">
        <!-- Placeholder premium para la imagen (Reemplaza el src cuando tengas la foto) -->
        <img 
          src="/contactForm.jpg" 
          alt="Consultoría Tecnológica Havenser" 
          class="w-full h-full object-cover  mix-blend-overlay"
        />
        <!-- Gradiente para fundir sutilmente la imagen con la interfaz -->
        <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-[#10192d]/90 to-transparent pointer-events-none"></div>
      </div>

      <!-- Lado Derecho: Formulario y Logo -->
      <div class="w-full md:w-[50%] md:ml-auto p-8 md:p-14 relative z-10 flex flex-col justify-end">
        
        <div class="mb-8 text-right flex flex-col items-end">
          <!-- Logo de Havenser -->
          <img src="/LOGO1.png" alt="Havenser Logo" class="h-14 md:h-16 w-auto mb-6 rounded" />
          
          <h2 class="text-3xl md:text-4xl font-bold text-[#e6e6f0] mb-2" style="font-family: Georgia, serif;">
            Transformemos su Operación
          </h2>
          <p class="text-[#8d94a1] text-lg" style="font-family: Calibri, sans-serif;">
            ¿Tiene un desafío técnico complejo? Hablemos.
          </p>
        </div>

        <!-- Redes Sociales -->
        <div class="flex gap-4 justify-center mb-4">
          <IconoLinkedin/>
          <IconoFacebook/>
          <IconoWhatsApp/>
          <IconoGmail/>
        </div>

        <form id="contacto-form" class="space-y-5">
          
          <!-- Input: Nombre -->
          <div class="flex flex-col gap-1.5 group">
            <label for="nombre" class="text-sm font-semibold text-[#8d94a1] group-focus-within:text-[#e6e6f0] transition-colors" style="font-family: Calibri, sans-serif;">
              Nombre Completo
            </label>
            <input 
              type="text" 
              id="nombre" 
              name="nombre"
              placeholder="Ingresa tu nombre" 
              required
              class="w-full bg-[#10192d] border border-[#3e4b61] text-[#e6e6f0] rounded-lg px-4 py-3 focus:outline-none focus:border-[#e6e6f0] focus:shadow-[0_0_8px_rgba(230,230,240,0.1)] transition-all duration-300"
              style="font-family: Calibri, sans-serif;" 
            />
          </div>
          
          <!-- Input: Email -->
          <div class="flex flex-col gap-1.5 group">
            <label for="email" class="text-sm font-semibold text-[#8d94a1] group-focus-within:text-[#e6e6f0] transition-colors" style="font-family: Calibri, sans-serif;">
              Correo Corporativo
            </label>
            <input 
              type="email" 
              id="email" 
              name="email"
              placeholder="nombre@empresa.com" 
              required
              class="w-full bg-[#10192d] border border-[#3e4b61] text-[#e6e6f0] rounded-lg px-4 py-3 focus:outline-none focus:border-[#e6e6f0] focus:shadow-[0_0_8px_rgba(230,230,240,0.1)] transition-all duration-300"
              style="font-family: Calibri, sans-serif;" 
            />
          </div>
          
          <!-- Input: Telefono -->
          <div class="flex flex-col gap-1.5 group">
            <label for="tel" class="text-sm font-semibold text-[#8d94a1] group-focus-within:text-[#e6e6f0] transition-colors" style="font-family: Calibri, sans-serif;">
              Teléfono de contacto
            </label>
            <input 
              type="tel" 
              id="tel" 
              name="telefono"
              placeholder="+52 77668843" 
              required
              class="w-full bg-[#10192d] border border-[#3e4b61] text-[#e6e6f0] rounded-lg px-4 py-3 focus:outline-none focus:border-[#e6e6f0] focus:shadow-[0_0_8px_rgba(230,230,240,0.1)] transition-all duration-300"
              style="font-family: Calibri, sans-serif;" 
            />
          </div>

          <!-- Input: Asunto -->
          <div class="flex flex-col gap-1.5 group">
            <label for="asunto" class="text-sm font-semibold text-[#8d94a1] group-focus-within:text-[#e6e6f0] transition-colors" style="font-family: Calibri, sans-serif;">
              Asunto
            </label>
            <input 
              type="text" 
              id="asunto" 
              name="asunto"
              placeholder="Motivo de tu mensaje"
              class="w-full bg-[#10192d] border border-[#3e4b61] text-[#e6e6f0] rounded-lg px-4 py-3 focus:outline-none focus:border-[#e6e6f0] focus:shadow-[0_0_8px_rgba(230,230,240,0.1)] transition-all duration-300"
              style="font-family: Calibri, sans-serif;" 
            />
          </div>

          <!-- Textarea: Mensaje -->
          <div class="flex flex-col gap-1.5 group">
            <label for="mensaje" class="text-sm font-semibold text-[#8d94a1] group-focus-within:text-[#e6e6f0] transition-colors" style="font-family: Calibri, sans-serif;">
              Mensaje
            </label>
            <textarea 
              id="mensaje" 
              name="mensaje"
              rows="4" 
              placeholder="Cuéntanos sobre los cuellos de botella de tu organización..." 
              
              class="w-full bg-[#10192d] border border-[#3e4b61] text-[#e6e6f0] rounded-lg px-4 py-3 focus:outline-none focus:border-[#e6e6f0] focus:shadow-[0_0_8px_rgba(230,230,240,0.1)] transition-all duration-300 resize-none"
              style="font-family: Calibri, sans-serif;"
            ></textarea>
          </div>

          <!-- Botón de Envío -->
          <button 
            type="submit" 
            class="w-full mt-4 bg-[#3e4b61] border border-transparent text-[#e6e6f0] font-bold text-lg rounded-lg px-6 py-4 hover:bg-transparent hover:border-[#e6e6f0] hover:text-[#e6e6f0] transition-all duration-300 transform hover:-translate-y-1 shadow-lg"
            style="font-family: Calibri, sans-serif;"
          >
            Enviar Solicitud
          </button>
          
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contacto-form');
  const endpoint = 'https://r8xpf2mp58.execute-api.us-east-2.amazonaws.com/prod/contacto';

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Enviando...';
    }

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error(`La solicitud fallo con estado ${response.status}`);
      }

      form.reset();
      alert('Tu solicitud fue enviada correctamente.');
    } catch (error) {
      console.error('Error al enviar el formulario de contacto:', error);
      alert('No fue posible enviar tu solicitud. Intenta nuevamente.');
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Enviar Solicitud';
      }
    }
  });
</script>

<style>
  /* === MAGIA DEL CORTE DIAGONAL === */
  .diagonal-split {
    /* Por defecto (móviles): Corte diagonal en la parte inferior para que apunte hacia el formulario */
    clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
  }
  
  @media (min-width: 768px) {
    .diagonal-split {
      /* En escritorio: Corte diagonal severo en el lado derecho, revelando el formulario */
      clip-path: polygon(0 0, 100% 0, 75% 100%, 0 100%);
    }
  }
</style>