---
// NatureTechBrain.astro
// Componente SVG puro y modular. Sin texto, listo para incrustar.

// Generamos posiciones aleatorias para las partículas del Bosque (Izquierda)
const forestParticles = Array.from({ length: 30 }).map(() => ({
  x: Math.floor(Math.random() * 200) + 50,  // Entre X:50 y X:250
  y: Math.floor(Math.random() * 150) + 100  // Entre Y:100 y Y:250
}));

// Generamos posiciones aleatorias para las partículas de la Ciudad (Derecha)
const cityParticles = Array.from({ length: 30 }).map(() => ({
  x: Math.floor(Math.random() * 200) + 550, // Entre X:550 y X:750
  y: Math.floor(Math.random() * 170) + 80   // Entre Y:80 y Y:250
}));
---

<div class="morph-viz-wrapper">
  <svg class="morph-svg" viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Filtros de resplandor para el cerebro y partículas -->
      <filter id="glow-brain" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
      <filter id="glow-particle" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="2" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <!-- ESCENA 1: BOSQUE Y CIUDAD -->
    <g class="scene-origin">
      <!-- Suelos -->
      <line class="ground-path" x1="30" y1="260" x2="300" y2="260" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
      <line class="ground-path" x1="500" y1="260" x2="770" y2="260" stroke="#3b82f6" stroke-width="2" stroke-linecap="round"/>

      <!-- Bosque (Izquierda) -->
      <g class="forest-paths" stroke="#10b981" stroke-width="2" fill="none" stroke-linejoin="round">
        <path d="M 120 130 L 80 260 L 160 260 Z" />
        <path d="M 170 90 L 130 260 L 210 260 Z" />
        <path d="M 230 150 L 190 260 L 270 260 Z" />
      </g>

      <!-- Ciudad (Derecha) -->
      <g class="city-paths" stroke="#3b82f6" stroke-width="2" fill="none" stroke-linejoin="round">
        <!-- Edificios -->
        <path d="M 520 260 L 520 140 L 580 140 L 580 260 Z" />
        <path d="M 590 260 L 590 70 L 660 70 L 660 260 Z" />
        <path d="M 670 260 L 670 120 L 740 120 L 740 260 Z" />
        <!-- Ventanas -->
        <line x1="540" y1="170" x2="560" y2="170" />
        <line x1="540" y1="210" x2="560" y2="210" />
        <line x1="610" y1="110" x2="640" y2="110" />
        <line x1="610" y1="160" x2="640" y2="160" />
        <line x1="610" y1="210" x2="640" y2="210" />
        <line x1="690" y1="160" x2="720" y2="160" />
        <line x1="690" y1="210" x2="720" y2="210" />
      </g>
    </g>

    <!-- ESCENA 2: PARTÍCULAS DE SÍNTESIS -->
    <g class="particles-group">
      {forestParticles.map((p) => (
        <circle class="f-particle" cx={p.x} cy={p.y} r="3" fill="#10b981" filter="url(#glow-particle)" />
      ))}
      {cityParticles.map((p) => (
        <circle class="c-particle" cx={p.x} cy={p.y} r="3" fill="#3b82f6" filter="url(#glow-particle)" />
      ))}
    </g>

    <!-- ESCENA 3: EL CEREBRO -->
    <g class="brain-group" stroke="#d946ef" stroke-width="3" fill="none" stroke-linecap="round" filter="url(#glow-brain)">
      <!-- Contorno de los hemisferios -->
      <path class="brain-path" d="M 400 250 C 280 250 250 150 300 80 C 330 40 380 40 400 60 C 420 40 470 40 500 80 C 550 150 520 250 400 250 Z" />
      
      <!-- Pliegues internos (Surcos y circunvoluciones) -->
      <g stroke-width="2">
        <path class="brain-fold" d="M 400 60 L 400 240" />
        <path class="brain-fold" d="M 400 90 C 350 90 330 140 370 160" />
        <path class="brain-fold" d="M 400 130 C 450 120 470 180 430 200" />
        <path class="brain-fold" d="M 390 190 C 340 210 320 240 350 250" />
        <path class="brain-fold" d="M 410 210 C 460 220 480 240 460 250" />
      </g>
    </g>
  </svg>
</div>

<style>
  .morph-viz-wrapper {
    width: 80%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }

  .morph-svg {
    width: 80%;
    height: auto;
    max-width: 600px;
    overflow: visible;
  }

  /* Ocultamos los elementos inicialmente para que Anime.js maneje su entrada sin parpadeos */
  .ground-path, .forest-paths path, .city-paths path, .city-paths line,
  .brain-path, .brain-fold, .f-particle, .c-particle {
    opacity: 0;
  }

  .brain-group {
    transform-origin: 400px 150px;
  }
</style>

<script>
  import { createTimeline, stagger, type Target } from 'animejs';

  const getDashOffset = (target?: Target) => {
    return target instanceof SVGGeometryElement ? target.getTotalLength() : 0;
  };

  document.addEventListener('DOMContentLoaded', () => {
    const svgs = document.querySelectorAll('.morph-svg');

    svgs.forEach((svg) => {
      // Configuramos el offset de los trazos para el efecto de "dibujado"
      const allPaths = svg.querySelectorAll('.ground-path, .forest-paths path, .city-paths path, .city-paths line, .brain-path, .brain-fold');
      allPaths.forEach(path => {
        const dashOffset = getDashOffset(path);
        path.setAttribute('stroke-dasharray', String(dashOffset));
        path.setAttribute('stroke-dashoffset', String(dashOffset));
      });

      // Creamos la línea de tiempo principal en bucle
      const tl = createTimeline({
        loop: true,
        autoplay: true
      });

      tl
        // 1. DIBUJAR ORIGENES: Crecen el bosque y la ciudad simultáneamente
        .add(svg.querySelectorAll('.ground-path, .forest-paths path, .city-paths path, .city-paths line'), {
          strokeDashoffset: [getDashOffset, 0],
          opacity: [0, 1],
          ease: 'inOutSine',
          duration: 2000,
          delay: stagger(50)
        })
        
        // 2. EXTRACCIÓN DE DATOS: Aparecen las partículas sobre los ecosistemas
        .add(svg.querySelectorAll('.f-particle, .c-particle'), {
          opacity: [0, 1],
          scale: [0, 1.2],
          ease: 'outBack',
          duration: 800,
          delay: stagger(20)
        }, '+=500')

        // 3. DISOLUCIÓN: El bosque y la ciudad se desvanecen 
        .add(svg.querySelectorAll('.ground-path, .forest-paths path, .city-paths path, .city-paths line'), {
          strokeDashoffset: [0, getDashOffset],
          opacity: 0,
          ease: 'inOutSine',
          duration: 1200
        }, '-=500')

        // 4. SÍNTESIS: Las partículas viajan a la singularidad (centro)
        .add(svg.querySelectorAll('.f-particle, .c-particle'), {
          cx: 400,
          cy: 150,
          ease: 'inOutExpo',
          duration: 1200,
          delay: stagger(10)
        }, '-=800')

        // 5. NACIMIENTO DEL CEREBRO: Las partículas desaparecen y el cerebro se dibuja
        .add(svg.querySelectorAll('.f-particle, .c-particle'), {
          opacity: 0,
          scale: 0,
          duration: 300
        }, '-=200')
        .add(svg.querySelectorAll('.brain-path, .brain-fold'), {
          strokeDashoffset: [getDashOffset, 0],
          opacity: [0, 1],
          ease: 'outSine',
          duration: 1500,
          delay: stagger(150)
        }, '-=500')

        // 6. PROCESAMIENTO: El cerebro emite un pulso neuronal (escala y resplandor)
        .add(svg.querySelector('.brain-group')!, {
          scale: [1, 1.08, 1],
          opacity: [1, 0.7, 1],
          ease: 'inOutSine',
          duration: 1800
        })

        // 7. REINICIO: El cerebro se desdibuja para comenzar de nuevo
        .add(svg.querySelectorAll('.brain-path, .brain-fold'), {
          strokeDashoffset: [0, getDashOffset],
          opacity: 0,
          ease: 'inOutSine',
          duration: 1500
        }, '+=1000');
    });
  });
</script>