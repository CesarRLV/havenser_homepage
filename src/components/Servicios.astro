---

<section id="servicios" class="py-24 bg-[#10192d] relative overflow-hidden text-[#e6e6f0] z-10">
  <PortadaImagen
    alto="70vh"
    urlImagen="/banner_city.jpg"
    titulo="Nuevos Retos..."
    parrafo="nuevas fronteras."
    direction="left"
  />
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden mt-5">
    <div class="absolute w-150 h-150 bg-[#c9a126] opacity-[0.03] rounded-full blur-[100px] top-32 -left-32"></div>
    <div class="absolute w-200 h-200 bg-[#6e7b90] opacity-[0.03] rounded-full blur-[100px] bottom-10 right-[-20%]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 mt-15">
    
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-[#e6e6f0]" style="font-family: Georgia, serif;">
        Portafolio de <span class="text-[#c9a126]">Soluciones</span>
      </h2>
      <p class="text-lg md:text-xl text-[#e6e6f0]/80 leading-relaxed" style="font-family: Calibri, sans-serif;">
        Arquitecturas tecnológicas avanzadas <strong class="text-[#c9a126]/85">diseñadas a la medida </strong>
        para resolver la complejidad operativa y escalar su <strong class="text-[#c9a126]/85"> rentabilidad B2B </strong> .
      </p>
    </div>

    <!-- Grid Orgánico y Off-Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-start pb-12">
      {servicios.map((srv, index) => (
        <div class={`
          bg-[#152036] p-6 md:p-8 rounded-2xl border border-[#3e4b61] shadow-xl 
          transition-all duration-500 group md:hover:-translate-y-4 md:hover:shadow-[0_15px_40px_rgba(201,161,38,0.12)] md:hover:border-[#c9a126]
          flex flex-col h-full relative overflow-hidden
          ${index % 3 === 1 ? 'lg:mt-16' : ''} 
          ${index % 3 === 2 ? 'lg:mt-32' : ''}
        `}>
          
          <div class="absolute inset-0 bg-linear-to-br from-[#c9a126]/5 to-transparent opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

          <!-- HEADER DE LA TARJETA (Imagen + Icono + Título + Flecha en móvil) -->
          <div class="accordion-header cursor-pointer md:cursor-auto select-none md:select-auto w-full relative z-10">
            
            <!-- Espacio para la Imagen -->
            <div class="w-full h-36 md:h-44 mb-6 bg-[#10192d] border border-[#3e4b61]/50 rounded-xl flex items-center justify-center overflow-hidden relative group-hover:border-[#c9a126]/40 transition-colors duration-300">
              <span class="text-[#6e7b90]/50 text-xs font-bold uppercase tracking-widest text-center px-4" style="font-family: Calibri, sans-serif;">
                [ Espacio Imagen: {srv.title} ]
              </span>
              <!-- Cuando tengas las imágenes, descomenta la siguiente línea: -->
              <!-- {srv.image && <img src={srv.image} alt={srv.title} class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" />} -->
            </div>

            <!-- Título e Icono -->
            <div class="flex items-center justify-between md:block">
              <div class="flex items-center md:block gap-4">
                <div class="text-4xl md:text-5xl md:mb-6 transform md:group-hover:scale-110 transition-transform duration-300 origin-left">
                  {srv.icon}
                </div>
                <h3 class="text-xl md:text-3xl font-bold text-[#e6e6f0] md:group-hover:text-[#c9a126] transition-colors duration-300" style="font-family: Georgia, serif;">
                  {srv.title}
                </h3>
              </div>
              <!-- Flecha (Solo visible en Móvil) -->
              <div class="md:hidden text-[#c9a126] transition-transform duration-300 chevron">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>
          
          <!-- CUERPO DE LA TARJETA (Acordeón oculto en móvil, siempre visible en escritorio) -->
          <div class="accordion-body hidden opacity-0 md:flex md:opacity-100 flex-col grow mt-4 md:mt-0 transition-opacity duration-300 relative z-10">
            <p class="text-[#e6e6f0]/90 mb-3 mt-2 md:mt-4 text-[1.05rem] leading-relaxed grow" style="font-family: Calibri, sans-serif;">
              {srv.desc}
            </p>

            <ul class="space-y-3 mb-8 border-t border-[#3e4b61]/50 pt-6">
              {srv.subs.map((sub) => (
                <li class="flex items-start text-sm text-[#e6e6f0]/80 group/item" style="font-family: Calibri, sans-serif;">
                  <svg class="w-5 h-5 text-[#6e7b90] mr-3 mt-0.5 md:group-hover/item:text-[#c9a126] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span class="text-sm md:text-lg md:group-hover/item:text-[#e6e6f0] transition-colors">{sub}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-2 pb-2 md:pb-0">
              <a href={srv.link} class="inline-flex items-center text-[#c9a126] font-bold text-sm hover:text-[#e6e6f0] transition-colors duration-300" style="font-family: Calibri, sans-serif; letter-spacing: 0.5px;">
                Agendar Consultoría
                <svg class="w-4 h-4 ml-2 transform md:group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>
          </div>
          
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Script Vanilla JS nativo de Astro para el Acordeón Móvil -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const headers = document.querySelectorAll('.accordion-header');
    
    headers.forEach(header => {
      header.addEventListener('click', () => {
        // Ejecutar animación de acordeón SOLO si estamos en una pantalla móvil (< 768px de Tailwind)
        if (window.innerWidth < 768) {
          const body = header.nextElementSibling;
          const chevron = header.querySelector('.chevron');

          if (!(body instanceof HTMLElement) || !(chevron instanceof HTMLElement)) return;
          
          if (body.classList.contains('hidden')) {
            // Acción: Desplegar
            body.classList.remove('hidden');
            body.classList.add('flex');
            // Pequeño retraso para que Tailwind procese el 'flex' antes de transicionar la opacidad
            setTimeout(() => {
              body.classList.remove('opacity-0');
              body.classList.add('opacity-100');
            }, 10);
            chevron.classList.add('rotate-180');
          } else {
            // Acción: Ocultar
            body.classList.remove('opacity-100');
            body.classList.add('opacity-0');
            chevron.classList.remove('rotate-180');
            setTimeout(() => {
              body.classList.remove('flex');
              body.classList.add('hidden');
            }, 300); // 300ms equivale a duration-300 de Tailwind
          }
        }
      });
    });
  });
</script>