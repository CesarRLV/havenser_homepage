---
import PortadaImagen from "./Portadas/PortadaImagen.astro";

// NOTA: estas imágenes reutilizan las que ya existen en /public.
// Sustitúyelas por fotos propias cuando las tengas (ideal 1600x1200 o mayor).
// Este arreglo alimenta el carrusel circular de abajo.
const slides = [
  {
    imagen: '/software.jpeg',
    etiqueta: 'Datos',
    titulo: 'Un solo catálogo, toda la operación',
    texto: 'Unificamos y depuramos la información de tus sucursales para que cada equipo trabaje sobre datos confiables.',
  },
  {
    imagen: '/ia.jpeg',
    etiqueta: 'Inteligencia artificial',
    titulo: 'Automatización que sí se usa',
    texto: 'Aplicamos IA a procesos concretos del negocio, no como demo: captura, validación y reglas que corren solas.',
  },
  {
    imagen: '/web_servicios.jpeg',
    etiqueta: 'Desarrollo a medida',
    titulo: 'Software construido para tu operación',
    texto: 'Plataformas y apps diseñadas alrededor de cómo trabaja tu equipo, no al revés.',
  },
  {
    imagen: '/iot.jpeg',
    etiqueta: 'Acompañamiento',
    titulo: 'Soporte que continúa después del lanzamiento',
    texto: 'Damos seguimiento técnico continuo para que cada solución evolucione con tu negocio.',
  },
];

// Tarjetas de servicio. `link` manda a la subpágina real del área cuando
// existe (ver src/pages/tech/ y src/pages/ciencia/); si no hay subpágina
// dedicada, manda a contacto.
const servicios = [
  {
    icon: "🤖",
    title: "AI & Data Operativa",
    desc: "Transformamos flujos manuales en activos de alto rendimiento mediante IA y machine learning.",
    subs: ["RPA y Agentes autónomos", "Pipelines de Datos (ETL)", "Modelos Analíticos Predictivos & RAGs"],
    link: "/tech/data",
    anchor: "ia",
  },
  {
    icon: "☁️",
    title: "Infraestructura Cloud",
    desc: "Ecosistemas distribuidos y arquitecturas escalables para operaciones transaccionales críticas.",
    subs: ["Despliegue y Desarrollo en la Nube", "Alertamiento Serverless", "Migraciones y optimizaciones"],
    link: "/tech/dev",
    anchor: "",
  },
  {
    icon: "💻",
    title: "Ingeniería de Software",
    desc: "Plataformas tecnológicas full-stack adaptadas a la lógica exacta y rentabilidad de su negocio.",
    subs: ["Desarrollo Web & Mobile", "Plataformas LMS y ERP", "Arquitectura de Bases de Datos"],
    link: "/tech/dev",
    anchor: "ingenieria",
  },
  {
    icon: "🥽",
    title: "Realidad Extendida (XR)",
    desc: "Soluciones de Spatial Computing para reducir costos y riesgos mediante inmersión 3D.",
    subs: ["Entrenamiento en VR", "Guiado Industrial con AR", "Colaboración en Realidad Mixta"],
    link: "/tech/virtual",
    anchor: "ra",
  },
  {
    icon: "🔒",
    title: "Ciberseguridad",
    desc: "Blindaje absoluto de sistemas contra ataques o fugas de información sensible.",
    subs: ["Penetration Testing", "Seguridad Cloud/On-Premise", "Marcos Normativos (Políticas)"],
    link: "/contactanos",
    anchor: "",
  },
  {
    icon: "🚚",
    title: "Logística Predictiva",
    desc: "Optimización de la cadena de suministro para erradicar cuellos de botella y costos extra.",
    subs: ["Modelos de Demanda (ML)", "Optimización de Rutas", "Simulación de Almacenes"],
    link: "/ciencia/logistica",
    anchor: "log",
  },
  {
    icon: "🧪",
    title: "Biotech y Modelado",
    desc: "Validación científica para escalar procesos químicos, médicos y agroalimentarios.",
    subs: ["Biocomputación Aplicada", "Modelos físico-matemáticos", "Consultoría en Bioseguridad y procesos químicos"],
    link: "/ciencia/biotech",
    anchor: "bio",
  },
  {
    icon: "🏢",
    title: "Gemelos Digitales (IoT)",
    desc: "Monitoreo en tiempo real para plantas de manufactura e infraestructura física.",
    subs: ["Integración de Sensores", "Dashboards Industriales", "Gemelos Digitales 3D"],
    link: "/ciencia/innova",
    anchor: "",
  },
  {
    icon: "🎓",
    title: "Capacitación y Mentoría",
    desc: "Transferencia de competencias técnicas para convertir a su equipo en analistas estratégicos.",
    subs: ["Academias Corporativas con cursos personalizados", "Cursos online"],
    link: "/cursos",
    anchor: "capacitaciones",
  },
];

const anguloPorSlide = 360 / slides.length;
---

<section class="bg-[var(--bg-light)] relative overflow-hidden text-[var(--text-heading)] z-10 pb-24">
  <PortadaImagen
    alto="70vh"
    urlImagen="/banner_city.jpg"
    titulo="Nuevos Retos..."
    parrafo="nuevas fronteras."
    direction="left"
  />
  <div id="servicios" class="absolute inset-0 pointer-events-none z-0 overflow-hidden mt-100">
    <div class="absolute w-150 h-150 bg-[#c9a126] opacity-[0.05] rounded-full blur-[100px] top-32 -left-32"></div>
    <div class="absolute w-200 h-200 bg-[#3e4b61] opacity-[0.04] rounded-full blur-[100px] bottom-10 right-[-20%]"></div>
  </div>

  <div class="mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-24 max-w-7xl">

    <!-- ENCABEZADO -->
    <div id="panel-contenido" class="max-w-2xl mx-auto text-center mb-16 opacity-0 translate-y-4 transition-all duration-700 ease-out">
      <h2 class="font-serif font-semibold text-4xl md:text-5xl leading-[1.12] tracking-tight text-[#10192d] mb-4" style="font-family: Georgia, serif;">
        Portafolio de <span class="text-[#c9a126]">Soluciones</span>
      </h2>
      <p class="text-base md:text-lg font-normal text-[#3e4b61] mb-8">
        Arquitecturas tecnológicas avanzadas <span class="text-[#c9a126] font-semibold">diseñadas a la medida</span> para resolver la complejidad operativa y escalar su <span class="text-[#c9a126] font-semibold">rentabilidad B2B</span>.
      </p>
      <a
        href="#contacto"
        class="inline-flex items-center px-7 py-3 bg-[#10192d] text-white font-semibold text-sm rounded-lg hover:bg-[#1c2c47] hover:-translate-y-0.5 transition-all duration-300"
      >
        Contáctanos
      </a>
    </div>

    <!-- CARRUSEL CIRCULAR (glassmorphism) -->
    <div class="orbit-carousel" role="region" aria-label="Casos de uso de Havenser">
      <div class="orbit-stage">
        <div class="orbit-ring" id="orbitRing">
          {slides.map((slide, i) => (
            <article
              class="orbit-card"
              data-index={i}
              style={`--angulo:${i * anguloPorSlide}deg; background-image: linear-gradient(180deg, rgba(16,25,45,0.15) 0%, rgba(16,25,45,0.86) 100%), url(${slide.imagen});`}
            >
              <span class="orbit-tag">{slide.etiqueta}</span>
              <h3 class="orbit-titulo">{slide.titulo}</h3>
              <p class="orbit-texto">{slide.texto}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="orbit-controles">
        <button type="button" class="orbit-flecha" id="orbitPrev" aria-label="Caso anterior">‹</button>
        <div class="orbit-puntos" role="tablist" aria-label="Seleccionar caso">
          {slides.map((slide, i) => (
            <button
              type="button"
              class="punto"
              data-index={i}
              data-activo={i === 0 ? 'true' : 'false'}
              aria-selected={i === 0 ? 'true' : 'false'}
              role="tab"
              aria-label={`Ver: ${slide.titulo}`}
            />
          ))}
        </div>
        <button type="button" class="orbit-flecha" id="orbitNext" aria-label="Caso siguiente">›</button>
      </div>
    </div>

    <!-- TARJETAS DE SERVICIO -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-20">
      {servicios.map((srv) => (
        <a
          href={srv.link}
          id={srv.anchor || undefined}
          class="servicio-card group bg-white/70 backdrop-blur-sm border border-[var(--border-soft)] rounded-2xl p-8 shadow-[0_10px_30px_rgba(16,25,45,0.05)] hover:shadow-[0_20px_45px_rgba(16,25,45,0.12)] hover:-translate-y-1.5 transition-all duration-500 flex flex-col h-full relative overflow-hidden"
        >
          <span class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[#c9a126] via-[#c9a126]/40 to-transparent"></span>

          <div class="w-14 h-14 rounded-xl bg-[#10192d] text-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-md">
            {srv.icon}
          </div>

          <h3 class="text-xl md:text-2xl font-bold text-[#10192d] mb-3" style="font-family: Georgia, serif;">
            {srv.title}
          </h3>

          <p class="text-[#3e4b61] mb-5 text-base leading-relaxed grow">
            {srv.desc}
          </p>

          <ul class="space-y-2.5 mb-6">
            {srv.subs.map((sub) => (
              <li class="flex items-start text-sm text-[#3e4b61]">
                <svg class="w-4 h-4 text-[#c9a126] mr-2.5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>{sub}</span>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-2 flex items-center text-[#c9a126] font-bold text-sm group-hover:text-[#10192d] transition-colors duration-300" style="letter-spacing: 0.4px;">
            Saber más
            <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<script define:vars={{ total: slides.length, anguloPorSlide }}>
  document.addEventListener('DOMContentLoaded', () => {
    const prefiereMenosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Entrada del bloque de texto
    const panelContenido = document.getElementById('panel-contenido');
    requestAnimationFrame(() => {
      setTimeout(() => {
        panelContenido?.classList.remove('opacity-0', 'translate-y-4');
      }, prefiereMenosMovimiento ? 0 : 150);
    });

    // --- Carrusel circular (glassmorphism) ---
    const stage = document.querySelector('.orbit-stage');
    const ring = document.getElementById('orbitRing');
    const tarjetas = Array.from(document.querySelectorAll('.orbit-card'));
    const puntos = Array.from(document.querySelectorAll('.orbit-puntos .punto'));
    const btnPrev = document.getElementById('orbitPrev');
    const btnNext = document.getElementById('orbitNext');

    if (!stage || !ring || tarjetas.length === 0) return;

    let radio = 0;
    let indiceActual = 0;
    let anguloActual = 0;
    let temporizador = null;

    function calcularRadio() {
      // El radio se deriva del ancho visible del escenario para que el
      // anillo se vea proporcionado en cualquier tamaño de pantalla.
      const ancho = stage.clientWidth;
      radio = Math.max(180, Math.min(ancho * 0.62, 460));
      tarjetas.forEach((tarjeta) => {
        const angulo = tarjeta.style.getPropertyValue('--angulo');
        tarjeta.style.transform = `rotateY(${angulo}) translateZ(${radio}px)`;
      });
    }

    function aplicarRotacion() {
      ring.style.transform = `translateZ(-${radio}px) rotateY(${-anguloActual}deg)`;
    }

    function actualizarEstadoActivo() {
      tarjetas.forEach((tarjeta, i) => {
        tarjeta.classList.toggle('activa', i === indiceActual);
      });
      puntos.forEach((punto, i) => {
        punto.setAttribute('data-activo', i === indiceActual ? 'true' : 'false');
        punto.setAttribute('aria-selected', i === indiceActual ? 'true' : 'false');
      });
    }

    function irA(indice) {
      indiceActual = ((indice % total) + total) % total;
      anguloActual = indiceActual * anguloPorSlide;
      aplicarRotacion();
      actualizarEstadoActivo();
    }

    function siguiente() {
      irA(indiceActual + 1);
    }
    function anterior() {
      irA(indiceActual - 1);
    }

    function iniciarAutoplay() {
      if (prefiereMenosMovimiento) return;
      detenerAutoplay();
      temporizador = setInterval(siguiente, 4500);
    }
    function detenerAutoplay() {
      if (temporizador) clearInterval(temporizador);
    }

    calcularRadio();
    irA(0);
    iniciarAutoplay();

    window.addEventListener('resize', calcularRadio);

    btnNext?.addEventListener('click', () => { detenerAutoplay(); siguiente(); iniciarAutoplay(); });
    btnPrev?.addEventListener('click', () => { detenerAutoplay(); anterior(); iniciarAutoplay(); });

    puntos.forEach((punto, i) => {
      punto.addEventListener('click', () => { detenerAutoplay(); irA(i); iniciarAutoplay(); });
    });
    tarjetas.forEach((tarjeta, i) => {
      tarjeta.addEventListener('click', () => { detenerAutoplay(); irA(i); iniciarAutoplay(); });
    });

    stage.addEventListener('mouseenter', detenerAutoplay);
    stage.addEventListener('mouseleave', iniciarAutoplay);
  });
</script>

<style>
  .orbit-carousel {
    position: relative;
    padding: 0 0 2rem 0;
  }

  .orbit-stage {
    position: relative;
    height: 380px;
    perspective: 1400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orbit-ring {
    position: relative;
    width: 1px;
    height: 1px;
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .orbit-card {
    position: absolute;
    top: -150px;
    left: -155px;
    width: 310px;
    height: 300px;
    border-radius: 20px;
    background-size: cover;
    background-position: center;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 20px 45px rgba(16, 25, 45, 0.18);
    backdrop-filter: blur(2px);
    cursor: pointer;
    opacity: 0.45;
    filter: blur(2px) saturate(0.7);
    transform-style: preserve-3d;
    transition: opacity 0.6s ease, filter 0.6s ease;
  }

  .orbit-card.activa {
    opacity: 1;
    filter: blur(0) saturate(1);
    box-shadow: 0 30px 60px rgba(16, 25, 45, 0.28);
  }

  .orbit-tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: #c9a126;
    margin-bottom: 0.5rem;
    display: block;
  }

  .orbit-titulo {
    font-family: Georgia, serif;
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .orbit-texto {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
  }

  .orbit-controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .orbit-flecha {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
    background: #fff;
    color: #10192d;
    font-size: 1.4rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .orbit-flecha:hover {
    background: #10192d;
    color: #fff;
    transform: translateY(-2px);
  }

  .orbit-puntos {
    display: flex;
    gap: 0.5rem;
  }

  .punto {
    width: 22px;
    height: 4px;
    border-radius: 999px;
    background: rgba(16, 25, 45, 0.15);
    transition: background-color 0.3s ease;
    cursor: pointer;
  }
  .punto[data-activo="true"] {
    background: #c9a126;
  }

  @media (max-width: 768px) {
    .orbit-stage {
      height: 300px;
      perspective: 900px;
    }
    .orbit-card {
      width: 230px;
      height: 250px;
      top: -125px;
      left: -115px;
      padding: 1.25rem;
    }
    .orbit-titulo {
      font-size: 1.1rem;
    }
  }
</style>
