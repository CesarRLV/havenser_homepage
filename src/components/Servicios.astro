---
const services = [
  {
    title: "Automatización e Inteligencia Operativa",
    subtitle: "AI & Data",
    desc: "Eliminamos cuellos de botella operativos mediante la implementación de modelos predictivos y machine learning. Transformamos flujos manuales en activos automatizados de alto rendimiento, incrementando drásticamente la eficiencia empresarial de su organización."
  },
  {
    title: "Infraestructura de Redes y Cloud",
    subtitle: "Web & Network Infrastructure",
    desc: "Diseñamos ecosistemas distribuidos robustos y arquitecturas cloud escalables. Garantizamos entornos de conectividad segura y de alta disponibilidad, estructurados para el soporte continuo de operaciones transaccionales críticas."
  },
  {
    title: "Ingeniería de Software y Sistemas",
    subtitle: "Aplicaciones a la Medida",
    desc: "Construimos plataformas tecnológicas adaptadas a la lógica exacta de su negocio. Desarrollamos sistemas web empresariales utilizando arquitecturas full-stack modernas, orientadas a maximizar su rentabilidad."
  },
  {
    title: "Simulación Predictiva e I+D",
    subtitle: "Investigación Aplicada",
    desc: "Ponemos el rigor científico al servicio de la industria. Desarrollamos modelos físico-matemáticos de alta fidelidad e investigación aplicada para resolver desafíos operativos complejos."
  },
  {
    title: "Ciberseguridad y Matemáticas Aplicadas",
    subtitle: "Protección de Activos",
    desc: "Protegemos sus activos digitales más valiosos. Integramos análisis matemáticos avanzados y auditorías de vulnerabilidad para blindar infraestructuras de red contra amenazas sistémicas."
  },
  {
    title: "Ingeniería y Cadena de Suministro",
    subtitle: "Optimización Industrial",
    desc: "Elevamos la competitividad industrial mediante la optimización tecnológica de procesos logísticos. Aplicamos modelado físico para optimizar el rendimiento y eficiencia de líneas de operación."
  },
  {
    title: "Aceleración Tecnológica Corporativa",
    subtitle: "Capacitación y Mentoría",
    desc: "Transferimos competencias técnicas de alto nivel a su talento interno. Diseñamos academias corporativas para convertir a sus equipos en analistas estratégicos dominando herramientas avanzadas."
  }
];
---
<section id="servicios" class="py-20 bg-brand-deep">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-title text-3xl md:text-4xl font-bold text-brand-light mb-4">Nuestros Servicios</h2>
      <p class="text-brand-blue text-lg font-body">Soluciones técnicas y científicas diseñadas para resolver la complejidad corporativa.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="bg-brand-dark p-8 rounded-lg border border-brand-gray hover:border-brand-yellow transition-colors duration-300 group">
          <div class="text-brand-blue text-sm font-bold tracking-wider uppercase mb-2 group-hover:text-brand-yellow transition-colors">{service.subtitle}</div>
          <h3 class="font-title text-xl font-bold text-brand-light mb-4">{service.title}</h3>
          <p class="text-brand-light/70 text-sm leading-relaxed">{service.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>