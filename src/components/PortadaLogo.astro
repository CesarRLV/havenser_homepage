---

---

<header class="hero">
    <div class="hero-wrapper">
        <div class="prism-h-container">
            <svg viewBox="0 0 100 100" class="prism-h-svg">
                <defs>
                    <linearGradient
                        id="gradient-havenser"
                        x1="0%"
                        y1="0%"
                        x2="100%"
                        y2="100%"
                    >
                        <stop
                            offset="0%"
                            style="stop-color:#3b82f6; stop-opacity:1"></stop>
                        <stop
                            offset="100%"
                            style="stop-color:#0f172a; stop-opacity:1"></stop>
                    </linearGradient>
                    <filter id="dropshadow" height="130%">
                        <feGaussianBlur in="SourceAlpha" stdDeviation="3"
                        ></feGaussianBlur>
                        <feOffset dx="2" dy="4" result="offsetblur"></feOffset>
                        <feMerge>
                            <feMergeNode></feMergeNode>
                            <feMergeNode in="SourceGraphic"></feMergeNode>
                        </feMerge>
                    </filter>
                </defs>
                <path
                    class="morphing-shape"
                    fill="url(#gradient-havenser)"
                    filter="url(#dropshadow)"
                >
                    <animate
                        attributeName="d"
                        dur="10s"
                        repeatCount="indefinite"
                        values="
                    M 50,10 L 50,10 L 50,10 L 10,90 L 10,90 L 10,90 L 90,90 L 90,90 L 90,90 L 50,10 L 50,10 L 50,10 Z; 
                    M 20,20 L 20,80 L 35,80 L 35,60 L 65,60 L 65,80 L 80,80 L 80,20 L 65,20 L 65,45 L 35,45 L 35,20 Z; 
                    M 50,10 L 50,10 L 50,10 L 10,90 L 10,90 L 10,90 L 90,90 L 90,90 L 90,90 L 50,10 L 50,10 L 50,10 Z"
                        keyTimes="0; 0.5; 1"
                        calcMode="spline"
                        keySplines="0.4 0 0.2 1; 0.4 0 0.2 1"></animate>
                </path>
            </svg>
        </div>

        <div class="hero-content">
            <h1>Innovación, Datos y Tecnología</h1>
            <p>
                Potenciando el futuro a través de la inteligencia artificial y
                la nube.
            </p>
        </div>
    </div>
</header>

<style>
    .hero {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: var(--bg-light);
        color: var(--text-dark);
        text-align: center;
    }

    .hero-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .prism-h-container {
        perspective: 1000px;
        width: 250px;
        height: 250px;
        margin-bottom: 20px;
    }

    .prism-h-svg {
        width: 100%;
        height: 100%;
        transform: rotateY(15deg) rotateX(10deg);
        transition: transform 0.3s;
    }

    .prism-h-container:hover .prism-h-svg {
        transform: rotateY(-10deg) rotateX(-5deg) scale(1.05);
    }

    .hero-content h1 {
        font-size: 3rem;
        margin-bottom: 10px;
    }

    .hero-content p {
        font-size: 1.5rem;
    }
</style>
