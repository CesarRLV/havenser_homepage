---

import IconoFacebook from "./IconosRedesSociales/IconoFacebook.astro";
import IconoGmail from "./IconosRedesSociales/IconoGmail.astro";
import IconoLinkedin from "./IconosRedesSociales/IconoLinkedin.astro";
import IconoWhatsApp from "./IconosRedesSociales/IconoWhatsApp.astro";

// src/components/Footer.astro

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#152036] border-t border-[#3e4b61] pt-16 pb-8 relative z-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    <!-- Grid Principal del Footer -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <!-- Columna 1: Marca y Eslogan -->
      <div class="flex flex-col">
        <a href="#" class="flex items-center gap-3 mb-4 group">
          <!-- Si tienes el isotipo separado, puedes inyectarlo aquí. Por ahora, un icono premium: -->
          <div class="w-10 h-10 bg-[#10192d] border border-[#3e4b61] rounded-lg flex items-center justify-center text-[#c9a126] group-hover:scale-105 transition-transform">
            <span class="text-xl font-bold" style="font-family: Georgia, serif;">H</span>
          </div>
          <span class="text-2xl font-bold text-[#e6e6f0] tracking-wide" style="font-family: Georgia, serif;">
            Havenser
          </span>
        </a>
        <p class="text-[#8d94a1] text-md leading-relaxed mb-6" style="font-family: Calibri, sans-serif;">
          "Innovación inteligente, ejecución impecable."
        </p>
        
        <!-- Redes Sociales -->
        <div class="flex gap-4">
          <IconoLinkedin/>
          <IconoFacebook/>
          <IconoWhatsApp/>
          <IconoGmail/>
        </div>
      </div>

      <!-- Columna 2: Mapa del Sitio -->
      <div>
        <h4 class="text-lg font-bold text-[#e6e6f0] mb-6" style="font-family: Georgia, serif;">Navegación</h4>
        <ul class="space-y-3" style="font-family: Calibri, sans-serif;">
          <li><a href="#nosotros" class="text-[#8d94a1] hover:text-[#c9a126] transition-colors duration-300 text-md">¿Quiénes Somos?</a></li>
          <li><a href="#servicios" class="text-[#8d94a1] hover:text-[#c9a126] transition-colors duration-300 text-md">Portafolio de Soluciones</a></li>
          <li><a href="#equipo" class="text-[#8d94a1] hover:text-[#c9a126] transition-colors duration-300 text-md">Nuestro Equipo</a></li>
          <li><a href="#contacto" class="text-[#8d94a1] hover:text-[#c9a126] transition-colors duration-300 text-md">Agendar Consultoría</a></li>
        </ul>
      </div>

      <!-- Columna 3: Contacto Operativo -->
      <div>
        <h4 class="text-lg font-bold text-[#e6e6f0] mb-6" style="font-family: Georgia, serif;">Contacto Corporativo</h4>
        <ul class="space-y-4" style="font-family: Calibri, sans-serif;">
          <li class="flex items-start text-[#8d94a1] text-md">
            <svg class="w-5 h-5 text-[#6e7b90] mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:consultoria@havenser.com" class="hover:text-[#e6e6f0] transition-colors">consultoria@havenser.com</a>
          </li>
          <li class="flex items-start text-[#8d94a1] text-md">
            <svg class="w-5 h-5 text-[#6e7b90] mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>Pachuca de Soto, Hidalgo, México</span>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Legal -->
      <div>
        <h4 class="text-lg font-bold text-[#e6e6f0] mb-6" style="font-family: Georgia, serif;">Marco Legal</h4>
        <ul class="space-y-3" style="font-family: Calibri, sans-serif;">
          <li>
            <a href="/TerminosCondiciones" class="text-[#8d94a1] hover:text-[#c9a126] transition-colors duration-300 text-md flex items-center group">
              <svg class="w-4 h-4 mr-2 text-[#3e4b61] group-hover:text-[#c9a126] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              Términos y Condiciones
            </a>
          </li>
          <li>
            <a href="/AvisoPrivacidad" class="text-[#8d94a1] hover:text-[#c9a126] transition-colors duration-300 text-md flex items-center group">
              <svg class="w-4 h-4 mr-2 text-[#3e4b61] group-hover:text-[#c9a126] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              Aviso de Privacidad
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Divisor y Copyright -->
    <div class="border-t border-[#3e4b61]/50 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[#8d94a1] text-md" style="font-family: Calibri, sans-serif;">
        &copy; {currentYear} Havenser. Todos los derechos reservados.
      </p>
      <div class="text-[#3e4b61] text-md" style="font-family: Calibri, sans-serif;">
        Diseñado con excelencia arquitectónica.
      </div>
    </div>

  </div>
</footer>