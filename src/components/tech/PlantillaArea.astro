---
// PlantillaArea.astro
//
// Componente único y reutilizable para las 6 subpáginas de área de
// especialidad (menús "Tech" y "Ciencia & logística" del navbar). Cada
// página .astro en src/pages/tech/ y src/pages/ciencia/ es solo un
// "wrapper" de 6-7 líneas que le pasa un objeto de
// src/data/areasEspecialidad.ts a este componente. Para editar el texto
// de una de estas páginas, edita ese archivo de datos, no este componente
// ni la página.
import type { AreaEspecialidad } from "../../data/areasEspecialidad";

interface Props {
  area: AreaEspecialidad;
}

const { area } = Astro.props;
---

<main class="bg-[var(--bg-light)] pt-28 pb-24">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-16" data-animar="fade-up">
      <div>
        <p class="text-[#c9a126] text-sm font-semibold uppercase tracking-[0.18em] mb-3">
          {area.categoria}
        </p>
        <h1 class="text-3xl md:text-5xl font-bold text-[#10192d] mb-6 leading-tight" style="font-family: Georgia, serif;">
          {area.titulo}
        </h1>
        <p class="text-lg text-[#3e4b61] leading-relaxed mb-8">
          {area.resumen}
        </p>
        <a
          href="/contactanos"
          class="inline-flex items-center justify-center bg-[#10192d] text-white font-bold px-8 py-4 rounded-xl hover:bg-[#1c2c47] hover:-translate-y-0.5 transition-all duration-300"
        >
          Agenda una consultoría sin costo
        </a>
      </div>
      <div>
        <img src={area.imagen} alt={area.titulo} class="rounded-2xl shadow-xl object-cover w-full h-72 md:h-[420px]" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {area.bullets.map((bullet, i) => (
        <div
          class="bg-white border border-[var(--border-soft)] rounded-2xl p-7 shadow-[0_10px_30px_rgba(16,25,45,0.05)] hover:shadow-[0_20px_40px_rgba(201,161,38,0.1)] hover:-translate-y-1 transition-all duration-300"
          data-animar="fade-up"
        >
          <div class="w-10 h-10 rounded-lg bg-[#10192d] text-[#c9a126] flex items-center justify-center font-bold mb-4">
            {String(i + 1).padStart(2, "0")}
          </div>
          <h3 class="text-lg font-bold text-[#10192d] mb-2" style="font-family: Georgia, serif;">
            {bullet.titulo}
          </h3>
          <p class="text-sm text-[#3e4b61] leading-relaxed">
            {bullet.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="text-center bg-white border border-[var(--border-soft)] rounded-2xl p-10 md:p-14" data-animar="fade-up">
      <h3 class="text-2xl md:text-3xl font-bold text-[#10192d] mb-4" style="font-family: Georgia, serif;">
        ¿Su empresa necesita esto?
      </h3>
      <p class="text-[#3e4b61] text-lg mb-8 max-w-xl mx-auto">
        Cuéntenos su caso. Revisamos si podemos ayudarle y cómo, sin costo.
      </p>
      <a
        href="/contactanos"
        class="inline-flex items-center justify-center bg-[#c9a126] text-[#10192d] font-bold px-9 py-4 rounded-xl hover:bg-[#e0b62c] hover:-translate-y-0.5 transition-all duration-300 shadow-lg"
      >
        Contáctanos
      </a>
    </div>

  </div>
</main>

<script>
  import { animate, inView } from 'motion';

  const prefiereMenosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefiereMenosMovimiento) {
    document.querySelectorAll<HTMLElement>('[data-animar]').forEach((el) => {
      el.style.opacity = '0';
      inView(el, () => {
        animate(el, { opacity: [0, 1], y: [24, 0] }, { duration: 0.6, easing: [0.22, 1, 0.36, 1] });
      }, { margin: '-10% 0px -10% 0px' });
    });
  }
</script>
