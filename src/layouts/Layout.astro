---
// 1. Necesitas este bloque (frontmatter) para poder importar archivos.
// 2. Importa tu archivo CSS global de Tailwind. 
// (Asegúrate de que la ruta coincida con donde guardaste tu global.css)
import '../styles/global.css'; 

// (Opcional pero recomendado) Recibir el título como una variable
// para que cada página pueda tener un título diferente en la pestaña del navegador.
const { title = "Havenser" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#111b2c] text-white">
		<slot />
	</body>
</html>