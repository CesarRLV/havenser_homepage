---
import Footer from "../components/Footer.astro";
---

<main class="bg-[#111b2c]">
    <slot/>
	<Footer/>
</main>

<style is:global>
	:root {
		/* ==========================================
     SISTEMA DE COLORES HAVENSER
     ========================================== */
		/* Fondo principal ultra oscuro (Seriedad y Tecnología) */
		--bg-main: #111b2c;

		/* Fondo secundario para tarjetas, navbar o secciones (Ligeramente más claro) */
		--bg-surface: #192232;

		/* Color de acento/bordes/hover (Profesionalismo) */
		--accent: #3e4b61;

		/* Texto secundario o descriptivo (Lectura cómoda) */
		--text-muted: #8d94a1;

		/* Texto principal y títulos (Contraste excelente, no cansa la vista como el blanco puro) */
		--text-light: #e6e6f0;
	}

	/* ==========================================
   RESETS Y TIPOGRAFÍA BASE
   ========================================== */
	html {
		scroll-behavior: smooth; /* Para que el menú navegue suavemente a las secciones */
	}
